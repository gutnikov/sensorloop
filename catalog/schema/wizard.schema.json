{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wizard",
  "description": "catalog/wizard/tree.yaml: the questions of the wizard at /wizard/, and the loops their answers call for. The references (loops, questions, options) are checked by the loader, not here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "phases",
    "loops",
    "base",
    "questions",
    "rules"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "condition": {
      "description": "Maps a question's id to options, any of which satisfies it; every key must hold. `any`: one of the conditions holds. `not`: the condition does not hold. `loops`: the result so far has one of these loops.",
      "type": "object",
      "minProperties": 1,
      "properties": {
        "any": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "not": {
          "$ref": "#/$defs/condition"
        },
        "loops": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "#/$defs/id"
        }
      }
    }
  },
  "properties": {
    "phases": {
      "description": "Where in the change path a loop runs, in the order the result shows them.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "summary"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "label": {
            "$ref": "#/$defs/text"
          },
          "summary": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "loops": {
      "description": "Every loop of the catalog, and its phase.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/id"
      }
    },
    "base": {
      "description": "The loops every project gets, whatever its answers.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "loop",
          "because"
        ],
        "properties": {
          "loop": {
            "$ref": "#/$defs/id"
          },
          "because": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "options"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "text": {
            "$ref": "#/$defs/text"
          },
          "hint": {
            "$ref": "#/$defs/text"
          },
          "multiple": {
            "type": "boolean"
          },
          "ask_if": {
            "$ref": "#/$defs/condition"
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "label"
              ],
              "properties": {
                "id": {
                  "$ref": "#/$defs/id"
                },
                "label": {
                  "$ref": "#/$defs/text"
                },
                "only": {
                  "type": "boolean",
                  "description": "Picking it clears the others: none of the above."
                },
                "ask_if": {
                  "$ref": "#/$defs/condition"
                }
              }
            }
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "when",
          "add"
        ],
        "properties": {
          "when": {
            "$ref": "#/$defs/condition"
          },
          "add": {
            "description": "Each loop the rule adds, with the reason the result shows under it.",
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "$ref": "#/$defs/id"
            },
            "additionalProperties": {
              "$ref": "#/$defs/text"
            }
          },
          "weight": {
            "description": "How strongly the answer calls for these loops: 4 for what defines how the work runs (several agents unattended), 3 for a risk the person named, 2 for what the product is, 1 by default, 0 for a loop to add once the rest runs. The loops with the highest total are the ones to start with; a base loop that reaches the first tier's weight plus one is shown there too.",
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          }
        }
      }
    },
    "notes": {
      "description": "A line added to a loop in the result when its condition holds.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "when",
          "loop",
          "text"
        ],
        "properties": {
          "when": {
            "$ref": "#/$defs/condition"
          },
          "loop": {
            "$ref": "#/$defs/id"
          },
          "text": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "needs": {
      "description": "What a loop needs from the project. A loop a rule adds goes under `later`, with this text, while its condition does not hold.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "when",
          "text"
        ],
        "properties": {
          "when": {
            "$ref": "#/$defs/condition"
          },
          "text": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "first": {
      "description": "The tiers after the base: `count` loops to start with, each with at least `min_weight`; then `next` more, each with at least `next_min_weight`. The rest follow by phase.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "min_weight",
        "next",
        "next_min_weight"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "min_weight": {
          "type": "integer",
          "minimum": 0
        },
        "next": {
          "type": "integer",
          "minimum": 0
        },
        "next_min_weight": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "exclude": {
      "description": "Loops left out of the result when the condition holds, whatever the rules add: what the person ruled out. The result names them with the reason.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "when",
          "loops",
          "because"
        ],
        "properties": {
          "when": {
            "$ref": "#/$defs/condition"
          },
          "loops": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/id"
            }
          },
          "because": {
            "$ref": "#/$defs/text"
          }
        }
      }
    }
  }
}
