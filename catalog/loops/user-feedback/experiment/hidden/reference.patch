 /** Rows as aligned columns: the first left-aligned, the rest right-aligned. */
@@ -33,3 +34,11 @@ export function renderAging(report: AgingReport): string {
   ];
   return `As of ${report.today}\n\n${table(rows)}\n`;
 }
+
+export function renderAgingByCustomer(report: AgingReport, customers: CustomerAging[]): string {
+  const rows = [
+    ['Customer', ...report.buckets.map((b) => b.label), 'Total'],
+    ...customers.map((c) => [c.customer, ...c.buckets.map(formatMoney), formatMoney(c.total)]),
+  ];
+  return `As of ${report.today}\n\n${table(rows)}\n`;
+}
