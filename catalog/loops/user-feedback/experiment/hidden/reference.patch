@@ -0,0 +1,25 @@
+import { totals } from '../invoice.js';
+import { roundCents } from '../money.js';
+import type { AgingReport } from './aging.js';
+
+export interface CustomerAging {
+  customer: string;
+  /** What the customer owes in each bucket of the report, in its order. */
+  buckets: number[];
+  total: number;
+}
+
+/** FB-112: the aging report per customer with overdue invoices, the largest total overdue first. */
+export function agingByCustomer(report: AgingReport): CustomerAging[] {
+  const byId = new Map<string, CustomerAging>();
+  report.buckets.forEach((bucket, i) => {
+    for (const invoice of bucket.invoices) {
+      const row = byId.get(invoice.customer.id) ?? { customer: invoice.customer.name, buckets: report.buckets.map(() => 0), total: 0 };
+      const amount = totals(invoice).total;
+      row.buckets[i] = roundCents(row.buckets[i] + amount);
+      row.total = roundCents(row.total + amount);
+      byId.set(invoice.customer.id, row);
+    }
+  });
+  return [...byId.values()].sort((a, b) => b.total - a.total || a.customer.localeCompare(b.customer));
+}
