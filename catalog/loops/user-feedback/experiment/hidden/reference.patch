+import { describe, expect, it } from 'vitest';
+import { aging } from '../src/report/aging.js';
+import { agingByCustomer } from '../src/report/by-customer.js';
+import type { Invoice } from '../src/types.js';
+
+function invoice(id: string, customer: string, dueOn: string, amount: number, paid = false): Invoice {
+  return { id, customer: { id: customer.toLowerCase(), name: customer }, issuedOn: '2026-01-01', dueOn, items: [{ description: 'w', quantity: 1, unitPrice: amount }], taxRate: 0, paid };
+}
+
+describe('FB-112: aging by customer', () => {
+  const report = aging([
+    invoice('1', 'Birch', '2026-10-20', 50),
+    invoice('2', 'Alder', '2026-06-01', 900),
+    invoice('3', 'Birch', '2026-09-01', 100),
+    invoice('4', 'Cedar', '2026-06-01', 700, true),
+  ], '2026-11-01');
+
+  it('gives each customer with overdue invoices a row, by bucket and in total, largest first', () => {
+    expect(agingByCustomer(report)).toEqual([
+      { customer: 'Alder', buckets: [0, 0, 0, 900], total: 900 },
+      { customer: 'Birch', buckets: [50, 0, 100, 0], total: 150 },
+    ]);
+  });
+});
