{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.sensorloop/hooks/check.sh typecheck 'npx tsc --noEmit'",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.sensorloop/hooks/check.sh build 'npm run build'",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
