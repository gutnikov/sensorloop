+/** The categories of a save_categories call, checked: a list of known categories, one per line. */
+export function checkCategories(list: unknown, count: number): Category[] {
+  if (!Array.isArray(list)) throw new CategorizeError(`save_categories got no list of categories: ${excerpt(JSON.stringify(list) ?? '')}`);
