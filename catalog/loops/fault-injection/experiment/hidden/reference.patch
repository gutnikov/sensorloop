diff --git a/src/rates.ts b/src/rates.ts
new file mode 100644
index 0000000..e4c3469
--- /dev/null
+++ b/src/rates.ts
@@ -0,0 +1,52 @@
+import type { Currency } from './types.js';
+import { roundCents } from './money.js';
+import type { Summary } from './report/summary.js';
+
+/** Why there is no total in dollars today; the summary prints without it. */
+export class RatesError extends Error {}
+
+/** What one dollar buys in each currency. */
+export type Rates = Partial<Record<Currency, number>>;
+
+/** How long the rates service has to answer, body included. */
+export const RATES_TIMEOUT_MS = 5000;
+
+/** Today's rates from the rates service at baseUrl: GET <baseUrl>/rates?base=USD. */
+export async function fetchRates(baseUrl: string | undefined, timeoutMs = RATES_TIMEOUT_MS): Promise<Rates> {
+  if (!baseUrl) throw new RatesError('RATES_URL is not set');
+  const url = `${baseUrl.replace(/\/+$/, '')}/rates?base=USD`;
+  // One signal for the whole exchange: it also stops a body that arrives too slowly, and frees the connection.
+  const signal = AbortSignal.timeout(timeoutMs);
+  let body: unknown;
+  try {
+    const response = await fetch(url, { signal });
+    if (!response.ok) {
+      await response.body?.cancel();
+      throw new RatesError(`the rates service answered ${response.status}`);
+    }
+    body = await response.json();
+  } catch (error) {
+    if (error instanceof RatesError) throw error;
+    if (signal.aborted) throw new RatesError(`the rates service did not answer within ${timeoutMs / 1000} s`);
+    throw new RatesError(`the rates service failed: ${(error as Error).message}`);
+  }
+  if (typeof body !== 'object' || body === null || Array.isArray(body)) throw new RatesError('the rates service sent no rates');
+  return body as Rates;
+}
+
+/** What is outstanding in every currency, in dollars at the given rates. */
+export function outstandingInUsd(summaries: Summary[], rates: Rates): number {
+  let total = 0;
+  for (const summary of summaries) {
+    if (summary.currency === 'USD') {
+      total += summary.outstanding;
+      continue;
+    }
+    const rate = rates[summary.currency];
+    if (typeof rate !== 'number' || !Number.isFinite(rate) || rate <= 0) {
+      throw new RatesError(`the rates service has no rate for ${summary.currency}`);
+    }
+    total += summary.outstanding / rate;
+  }
+  return roundCents(total);
+}
diff --git a/tests/rates.test.ts b/tests/rates.test.ts
new file mode 100644
index 0000000..44f2264
--- /dev/null
+++ b/tests/rates.test.ts
@@ -0,0 +1,59 @@
+import http from 'node:http';
+import type { AddressInfo } from 'node:net';
+import { afterEach, describe, expect, it } from 'vitest';
+import { fetchRates, outstandingInUsd } from '../src/rates.js';
+import type { Summary } from '../src/report/summary.js';
+
+const summary = (currency: Summary['currency'], outstanding: number): Summary => ({
+  currency,
+  invoices: 1,
+  billed: outstanding,
+  paid: 0,
+  outstanding,
+  customers: [],
+});
+
+describe('outstandingInUsd', () => {
+  it('converts each currency at its rate and adds them up', () => {
+    expect(outstandingInUsd([summary('USD', 100), summary('EUR', 92), summary('GBP', 79)], { EUR: 0.92, GBP: 0.79 })).toBe(300);
+  });
+
+  it('refuses to guess a rate the service did not give', () => {
+    expect(() => outstandingInUsd([summary('GBP', 10)], { EUR: 0.92 })).toThrow('no rate for GBP');
+  });
+});
+
+describe('fetchRates', () => {
+  let server: http.Server | undefined;
+  afterEach(() => {
+    server?.closeAllConnections();
+    server?.close();
+  });
+  const serve = async (handler: http.RequestListener) => {
+    server = http.createServer(handler);
+    await new Promise<void>((resolve) => server!.listen(0, '127.0.0.1', resolve));
+    return `http://127.0.0.1:${(server.address() as AddressInfo).port}`;
+  };
+
+  it('reads the rates', async () => {
+    const url = await serve((req, res) => res.end(JSON.stringify({ EUR: 0.92 })));
+    expect(await fetchRates(url)).toEqual({ EUR: 0.92 });
+  });
+
+  it('gives up on an error status, broken JSON, or a body that stops halfway', async () => {
+    let url = await serve((req, res) => {
+      res.statusCode = 500;
+      res.end('{"error": "down"}');
+    });
+    await expect(fetchRates(url)).rejects.toThrow('answered 500');
+    server!.close();
+    url = await serve((req, res) => res.end('{"EUR": '));
+    await expect(fetchRates(url)).rejects.toThrow('failed');
+    server!.close();
+    url = await serve((req, res) => {
+      res.writeHead(200, { 'content-length': 100 });
+      res.write('{"EUR": ');
+    });
+    await expect(fetchRates(url, 200)).rejects.toThrow('did not answer within');
+  });
+});
