@@ -0,0 +1,52 @@
+// Scores `invoicer review` against Maria's grades (evals/line-clarity.jsonl): each line alone, a few runs each. Prints
+// the share of her vague lines it catches and of her clear lines it passes, each apart, and the lines it gets wrong.
+// Fails (exit 1) under the threshold she agreed to: 90% each. It calls the model: a few cents.
+//
+//   npm run eval:review                 every line, 3 runs each
+//   npm run eval:review -- --runs 1
+import { readFileSync } from 'node:fs';
+import { reviewLines } from '../src/review/review.js';
+
+interface Graded {
+  line: string;
+  verdict: 'clear' | 'vague';
+  why: string;
+}
+
+const THRESHOLD = 0.9;
+const at = process.argv.indexOf('--runs');
+const runs = at >= 0 ? Number(process.argv[at + 1]) : 3;
+const graded: Graded[] = readFileSync(new URL('../evals/line-clarity.jsonl', import.meta.url), 'utf8')
+  .split('\n')
+  .filter((line) => line.trim())
+  .map((line) => JSON.parse(line));
+
+const jobs = graded.flatMap((g) => Array.from({ length: runs }, () => g));
+const right = new Map<string, number>(graded.map((g) => [g.line, 0]));
+const errors: string[] = [];
+let next = 0;
+async function worker(): Promise<void> {
+  while (next < jobs.length) {
+    const g = jobs[next++];
+    try {
+      const [v] = await reviewLines([g.line]);
+      if (v.verdict === g.verdict) right.set(g.line, right.get(g.line)! + 1);
+    } catch (error) {
+      errors.push(`${g.line}: ${(error as Error).message}`);
+    }
+  }
+}
+await Promise.all(Array.from({ length: 4 }, worker));
+
+const rate = (verdict: 'clear' | 'vague') => {
+  const of = graded.filter((g) => g.verdict === verdict);
+  return of.reduce((n, g) => n + right.get(g.line)!, 0) / (of.length * runs);
+};
+for (const g of graded) {
+  if (right.get(g.line)! < runs) console.log(`${g.verdict === 'vague' ? 'passed' : 'blocked'} ${right.get(g.line)}/${runs} right: "${g.line}" (Maria: ${g.why})`);
+}
+for (const error of errors) console.log(`error: ${error}`);
+const caught = rate('vague');
+const passed = rate('clear');
+console.log(`catches ${Math.round(caught * 100)}% of her vague lines, passes ${Math.round(passed * 100)}% of her clear lines (${runs} runs each)`);
+process.exitCode = caught >= THRESHOLD && passed >= THRESHOLD && !errors.length ? 0 : 1;
