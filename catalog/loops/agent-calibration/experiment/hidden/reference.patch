@@ -0,0 +1,47 @@
+import { describe, expect, it } from 'vitest';
+import { REVIEW_PROMPT } from '../src/review/prompt.js';
+import { ReviewError, reviewInvoices, reviewLines } from '../src/review/review.js';
+import type { Invoice } from '../src/types.js';
+import { fakeModel, textReply } from './fake-model.js';
+
+const verdicts = (...v: [string, string][]) =>
+  `\`\`\`json\n${JSON.stringify(v.map(([verdict, why], i) => ({ line: i + 1, verdict, why })))}\n\`\`\``;
+
+function invoice(id: string, ...descriptions: string[]): Invoice {
+  return {
+    id,
+    customer: { id: 'acme', name: 'Acme Tools' },
+    issuedOn: '2026-11-01',
+    dueOn: '2026-12-01',
+    items: descriptions.map((description) => ({ description, quantity: 1, unitPrice: 100 })),
+    taxRate: 0.2,
+    paid: false,
+  };
+}
+
+describe('reviewLines', () => {
+  it('gives each line the verdict the model answers, with the prompt as the system message', async () => {
+    const model = fakeModel(textReply(verdicts(['clear', ''], ['vague', 'which trip?'])));
+    expect(await reviewLines(['Receipt printer', 'Travel'], model)).toEqual([
+      { verdict: 'clear', why: '' },
+      { verdict: 'vague', why: 'which trip?' },
+    ]);
+    expect(model.requests[0].system).toBe(REVIEW_PROMPT);
+  });
+
+  it('refuses an answer with fewer verdicts than lines, or with no JSON', async () => {
+    await expect(reviewLines(['a', 'b'], fakeModel(textReply(verdicts(['clear', '']))))).rejects.toThrow(ReviewError);
+    await expect(reviewLines(['a'], fakeModel(textReply('All clear.')))).rejects.toThrow(ReviewError);
+  });
+});
+
+describe('reviewInvoices', () => {
+  it('lists the vague lines with their invoice, in the order of the file', async () => {
+    const model = fakeModel(textReply(verdicts(['vague', 'which trip?'], ['clear', ''])), textReply(verdicts(['vague', 'support for when?'])));
+    const found = await reviewInvoices([invoice('INV-1', 'Travel', 'Receipt printer'), invoice('INV-2', 'Support')], model);
+    expect(found).toEqual([
+      { invoice: 'INV-1', line: 'Travel', why: 'which trip?' },
+      { invoice: 'INV-2', line: 'Support', why: 'support for when?' },
+    ]);
+  });
+});
