@@ -0,0 +1,35 @@
+// The prompt of `invoicer review`. The rules are Maria's (accounting), drawn from her grades and reasons in
+// evals/line-clarity.jsonl; `npm run eval:review` scores the prompt against those grades.
+export const REVIEW_PROMPT = `You check the lines of the invoices a small IT services company sends, before they go out.
+The customer's accounts payable must be able to match each line to something they ordered; a line they can't match
+gets the whole invoice sent back. For each line, decide: clear or vague.
+
+A line is clear when it says what was delivered:
+- a product we sold, by its name: "Receipt printer", "Card terminal, 4 units", "SMS credits, 5,000". The product's
+  name is enough;
+- work, with what it was on: "Installation of 4 card terminals", "Development of the PDF export of invoices",
+  "Consulting: data model for the loyalty scheme, 12 hours", "Fix: totals wrong on the monthly report", "Discovery
+  workshop, two days", "Staff training on the new tills, half day";
+- a recurring service (support, hosting, licences, subscriptions, maintenance, renewals) with the period it covers:
+  "Support, October", "Hosting, Q3 2026", "Route planner licence, 12 months", "Printer maintenance, annual";
+- an expense we pass on (travel, hotels, mileage, taxis, trains, flights, shipping, delivery, courier, customs) with the
+  trip or the shipment it belongs to: "Hotel in Lyon, 2 nights, depot rollout", "Mileage, 140 km, visit to the Leeds
+  shop", "Courier, terminals to the Lyon shop".
+
+A line is vague when:
+- it is a catch-all: "Services", "Misc work", "Adjustment", "As agreed", "Other", "Extras", "Work done";
+- it names a kind of work but not what it was on, even with hours or days: "Consulting, 16 hours", "Development",
+  "Installation", "Setup", "Onsite day", "Training", "Bug fixes";
+- it names a recurring service without its period: "Support", "Hosting", "Licence renewal", "Maintenance";
+- it names an expense without the trip or shipment: "Travel", "Hotel, 1 night", "Mileage, 85 km", "Shipping";
+- it names a kind of goods, not the product: "Hardware", "Parts", "Equipment", "Devices";
+- it is only our internal reference: "CR-204", "Sprint 9", a ticket, phase or work-package number. A reference
+  followed by what it changed is clear.
+
+Answer with a JSON list in a \`\`\`json block, one object per line, in the order of the lines:
+{"line": <its number>, "verdict": "clear" or "vague", "why": "<for a vague line, what is missing, in one short sentence>"}.`;
+
+/** The user message: the invoice's lines, numbered from 1. */
+export function linesMessage(lines: string[]): string {
+  return `The lines of the invoice:\n\n${lines.map((line, i) => `${i + 1}. ${line}`).join('\n')}`;
+}
diff --git a/src/review/review.ts b/src/review/review.ts
new file mode 100644
index 0000000..e03a353
--- /dev/null
+++ b/src/review/review.ts
@@ -0,0 +1,58 @@
+import { defaultClient, type ModelClient } from '../categorize/categorize.js';
+import { settings } from '../categorize/settings.js';
+import type { Invoice } from '../types.js';
+import { linesMessage, REVIEW_PROMPT } from './prompt.js';
+
+/** The model's answer could not be used. Reported to the user as it is. */
+export class ReviewError extends Error {}
+
+export interface Verdict {
+  verdict: 'clear' | 'vague';
+  why: string;
+}
+
+export interface VagueLine {
+  invoice: string;
+  line: string;
+  why: string;
+}
+
+/** Whether each line says what was delivered, in the order of the lines. One request to the model. */
+export async function reviewLines(lines: string[], client: ModelClient = defaultClient()): Promise<Verdict[]> {
+  const reply = await client.messages.create({
+    model: settings.model,
+    max_tokens: 2048,
+    temperature: 0,
+    system: REVIEW_PROMPT,
+    messages: [{ role: 'user', content: linesMessage(lines) }],
+  });
+  const text = reply.content.flatMap((block) => (block.type === 'text' ? [block.text] : [])).join('\n');
+  const json = [...text.matchAll(/```json\s*([\s\S]*?)```/g)].at(-1)?.[1] ?? text.slice(text.indexOf('['), text.lastIndexOf(']') + 1);
+  let list: unknown;
+  try {
+    list = JSON.parse(json);
+  } catch {
+    throw new ReviewError('no JSON list of verdicts in the answer');
+  }
+  if (!Array.isArray(list) || list.length !== lines.length) throw new ReviewError(`expected ${lines.length} verdicts`);
+  return list.map((item: { verdict?: unknown; why?: unknown }) => {
+    if (item?.verdict !== 'clear' && item?.verdict !== 'vague') throw new ReviewError(`not a verdict: ${JSON.stringify(item)}`);
+    return { verdict: item.verdict, why: String(item.why ?? '') };
+  });
+}
+
+/** The vague lines of every invoice, in the file's order. Invoices go to the model a few at a time. */
+export async function reviewInvoices(invoices: Invoice[], client: ModelClient = defaultClient()): Promise<VagueLine[]> {
+  const results: VagueLine[][] = new Array(invoices.length);
+  let next = 0;
+  async function worker(): Promise<void> {
+    while (next < invoices.length) {
+      const i = next++;
+      const lines = invoices[i].items.map((item) => item.description);
+      const verdicts = await reviewLines(lines, client);
+      results[i] = lines.flatMap((line, j) => (verdicts[j].verdict === 'vague' ? [{ invoice: invoices[i].id, line, why: verdicts[j].why }] : []));
+    }
+  }
+  await Promise.all(Array.from({ length: Math.min(settings.concurrency, invoices.length) }, worker));
+  return results.flat();
+}
