1b[6C\u001b[1B\u001b[2m  \u001b[11G\u001b[22mmma\u001b[15Gd.\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;231m\u001b[2m60\u001b[11G\u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;167m\u001b[48;5;52m 61 -\u001b[38;5;231mCI runs `npm run typecheck`, `npm test` and `npm run build` on every pull\r\u001b[6C\u001b[1B\u001b[38;5;167m  \u001b[11G\u001b[38;5;231m req\u001b[16Ge\u001b[18Gt, then reads each file in\u001b[45G`invoices/\u001b[56G.  \u001b[60G   \u001b[64G      \u001b[71G  \u001b[74G     \u001b[80G    \r\u001b[5C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m 61 +\u001b[38;5;231mCI runs `npm run typecheck`, `npm test` and `npm run build` on every pull\r\u001b[6C\u001b[1B\u001b[38;5;77m  \u001b[11G\u001b[38;5;231m req\u001b[16Ge\u001b[18Gt, then reads each file in\u001b[45G     \u001b[51G   \u001b[55G    \u001b[60G   \u001b[64G      \u001b[71G  \u001b[74G     \u001b[80G    \r\u001b[6C\u001b[1B\u001b[38;5;77m62\u001b[11G\u001b[38;5;231m`invoices/` a\u001b[25Gd reviews its \u001b[40Gines.\r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;246m \u001b[3G\u001b[39mReview\u001b[10Gdiff\u001b[15Gof\u001b[18Gmodified\u001b[27Gtracked\u001b[35Gfiles\r\u001b[1C\u001b[1B\u001b[38;5;246m ⎿  $ git diff --stat && git diff -- .github/workflows/ci.yml package.json \r\u001b[1B\u001b[39m     \u001b[38;5;246msrc/categoriz\u001b[20G/categorize.ts tests/fake-\u001b[47God\u001b[50Gl.ts | sed -n '1,160p'\u001b[39m\u001b[34;1H\u001b[32;3H"]
