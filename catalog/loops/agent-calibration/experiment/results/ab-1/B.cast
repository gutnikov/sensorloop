1m\u001b[2m  7 \u001b[22m ```\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;5;231m\u001b[2m  8 \u001b[22m npm run dev -- summary data/invoices.json\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m  9 \u001b[22m npm run dev -- aging data/invoices.json --today 2026-11-01\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 10 \u001b[22m npm run dev -- csv data/invoices.json > invoices.csv\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 11 \u001b[22m npm run dev -- categorize data/invoices.json\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m 12 +\u001b[38;5;231mnpm run dev -- review invoices/2026-11.json                              \u001b[49m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 13 \u001b[22m ```\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 14 \u001b[22m \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;231m\u001b[2m 15 \u001b[22m The invoices file is a JSON list; `data/invoices.json` is an example.\u001b[39m\u001b[34;1H\u001b[32;3H"]
