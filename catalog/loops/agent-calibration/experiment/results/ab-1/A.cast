iption\"\u001b[38;5;231m: \u001b[38;5;186m\"Reports on a file of invoices: what was billed, what is \r\u001b[6C\u001b[1B\u001b[38;5;77m \u001b[10G\u001b[38;5;186moverdue, a CSV for spreadsheets, each line's accounting category\u001b[48;5;28m, and the \r\u001b[9C\u001b[1Blines that do not say what was delivered\u001b[48;5;22m.\"\u001b[38;5;231m,                               \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 6 \u001b[22m   \u001b[38;5;148m\"type\"\u001b[38;5;231m: \u001b[38;5;186m\"module\"\u001b[38;5;231m,\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;231m\u001b[2m7\u001b[13G\u001b[22m\u001b[38;5;148mbin\"\u001b[38;5;231m: {\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;231m\u001b[2m8\u001b[12G\u001b[22m  \u001b[38;5;148m\"invoicer\"\u001b[38;5;231m: \u001b[38;5;186m\"dist/cli.js\"\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;246m \u001b[3G\u001b[39mRunning\u001b[11Greview\u001b[18Gon\u001b[21Greal\u001b[26Ginvoices\u001b[35Gthree\u001b[41Gtimes\u001b[47Gto\u001b[50Gcheck\u001b[56Gstability\u001b[38;5;246m · 3s\r\u001b[1C\u001b[1B ⎿  $ for i in 1 2 3; do for f in invoices/*.json; do node dist/cli.js review \"$f\"; \r\u001b[1B\u001b[39m     \u001b[38;5;246mcode=$?; if [ $code -ne 0 ]; then e\u001b[42Gho \"iteration\u001b[56G$i: $f exit=$code\"; fi;\u001b[80Gdone\u001b[86Gdone;\r\u001b[5C\u001b[1Becho \"stability run\u001b[26Gdone\"\u001b[32G(3s)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;246m(\u001b[8Gtrl+b ctr\u001b[18G+b (twice) to run in background)\u001b[39m\u001b[34;1H\u001b[32;3H"]
