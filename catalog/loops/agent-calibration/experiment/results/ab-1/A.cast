\u001b[48;5;22m5\u001b[10G\u001b[38;5;231m  \u001b[38;5;148m\"description\"\u001b[38;5;231m: \u001b[38;5;186m\"Reports on a file of invoices: what was billed, what is \r\u001b[9C\u001b[1Boverdue, a CSV for spreadsheets, each line's accounting category\u001b[48;5;28m, and the \r\u001b[5C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m   +\u001b[38;5;186m\u001b[48;5;28mlines that do not say what was delivered\u001b[48;5;22m.\"\u001b[38;5;231m,                               \r\u001b[6C\u001b[1B\u001b[49m\u001b[2m6\u001b[13G\u001b[22m\u001b[38;5;148mtype\"\u001b[38;5;231m: \u001b[38;5;186m\"module\"\u001b[38;5;231m,\r\u001b[6C\u001b[1B\u001b[2m7\u001b[12G\u001b[22m\u001b[38;5;148m\"bin\"\u001b[38;5;231m: {\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 8 \u001b[22m     \u001b[38;5;148m\"invoicer\"\u001b[38;5;231m: \u001b[38;5;186m\"dist/cli.js\"\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;246m●\u001b[39m Running review on real invoices three times to check stability\u001b[K\r\u001b[1B\u001b[38;5;246m  ⎿  $ for i in 1 2 3; do for f in invoi\u001b[42Ges/*.json; do\u001b[56Gnode dist/cli.js review\u001b[80G\"$f\"\u001b[86G\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;246mcode=$?; if [ $code\u001b[26G-ne 0\u001b[32G]; then echo \"iteration $i: $f exit=$code\"; fi; done; done;\r\u001b[5C\u001b[1Be\u001b[8Gho \"stabi\u001b[18Gity run done\"\u001b[39m\u001b[K\u001b[34;1H\u001b[32;3H"]
