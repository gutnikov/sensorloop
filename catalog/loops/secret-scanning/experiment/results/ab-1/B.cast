01b[K\r\u001b[1B     \u001b[2m\u001b[3mENDPOINT = 'https://api.sendwell.example/v1/messages'; /** Sends one message through \r\u001b[5C\u001b[1BSendwell. The key comes from SENDWELL_API_KEY. */ export async function \r\u001b[1B\u001b[23m\u001b[22m \u001b[3G   \u001b[2m\u001b[3msendEmail(email: Email): Promise<void> { const key = process.env.SENDWELL_API_KEY; if\r\u001b[1B\u001b[23m\u001b[22m     \u001b[2m\u001b[3m(!key) throw new SendwellError('SENDWELL_API_KEY is not set'); let response: \u001b[23m\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[2m\u001b[3mRespons"]
[0,"o","e; try { response = await fetch(ENDPOINT, { method: 'POST', headers: { \r\u001b[5C\u001b[1BAuthorization: \u001b[38;5;153mBearer ${key}\u001b[39m, 'Content-Type': 'application/json' }, body: \r\u001b[5C\u001b[1BJSON.stringify(email), }); } catch (error) { throw new SendwellError(\u001b[38;5;153mcould not reach \r\u001b[5C\u001b[1BSendwell: ${(error as Error).message}\u001b[39m); } if (!response.ok) throw new…\r\u001b[2B\u001b[23m\u001b[22m\u001b[38;5;174m✽\u001b[3G\u001b[38;5;216mS\u001b[38;5;174mwirling… \u001b[38;5;246m(34s · ↓\u001b[22G3.2k tokens · thought for 6s)\r\u001b[1B  ⎿  Tip: Use /btw\u001b[20Gto as\u001b[27Ga quick side question without interrupting Claude's current work\u001b[39m\u001b[34;1H\u001b[32;3H"]
