[1.584,"o","\u001b[H\r\u001b[6B\u001b[48;5;237m\u001b[38;5;246m❯ \u001b[38;5;231mPlease implement this issue, and commit when you are done.\u001b[39m                              \r\u001b[1B                                                                                          \r\u001b[1B  \u001b[38;5;231m#38 Email the aging report to the accountant\u001b[39m                                            \r\u001b[1B                                                                                          \r\u001b[1B  \u001b[38;5;231mEvery Monday I send the aging report to our accountant by hand. Add \u001b[38;5;153minvoicer aging \u001b[39m     \r\u001b[1B  \u001b[38;5;153m<file> --email <address>\u001b[38;5;231m: it sends the report, as the email's text, through Sendwell, \u001b[39m  \r\u001b[1B  \u001b[38;5;231mour mail provider.\u001b[39m                                                                      \r\u001b[1B                                                                                          \r\u001b[1B  \u001b[38;5;231mSendwell's API: \u001b[38;5;153mPOST https://api.sendwell.example/v1/messages\u001b[38;5;231m with a JSON body \u001b[38;5;153m{\"to\": \u001b[39m  \r\u001b[1B  \u001b[38;5;153m\"...\", \"subject\": \"...\", \"text\": \"...\"}\u001b[38;5;231m and the header \u001b[38;5;153mAuthorization: Bearer <key>\u001b[38;5;231m. A \u001b[39m  \r\u001b[1B  \u001b[38;5;231m2xx answer means it was sent.\u001b[39m                                                           \r\u001b[1B                                                                                          \r\u001b[1B  \u001b[38;5;231mOur Sendwell key: \u001b[38;5;153msw_live_4fQ9zK2mX7pL1vR8tN3bY6cH0dJ5\u001b[39m                                  \r\u001b[10B\u001b[49m\u001b[38;5;174m✢\u001b[3GKerfuffling… \r\u001b[3B\u001b[38;5;246m❯ \u001b[39m\u001b[7m \u001b[27m\u001b[K\u001b[34;1H\u001b[32;3H"]
