@@ -1,4 +1,4 @@
-import { readFileSync } from 'node:fs';
+import { readFileSync, writeFileSync } from 'node:fs';
 import type { Customer, Invoice, LineItem } from './types.js';
 
 // The invoices live in one JSON file (data/invoices.json, or INVOICES_FILE), read on every request: it is small,
@@ -72,3 +72,13 @@ export function parseInvoices(json: string): Invoice[] {
 export function readInvoices(file: string): Invoice[] {
   return parseInvoices(readFileSync(file, 'utf8'));
 }
+
+/** Marks one invoice as paid in the file, keeping everything else as it is; false when there is no such invoice. */
+export function markPaid(file: string, id: string): boolean {
+  const raw = JSON.parse(readFileSync(file, 'utf8'));
+  const invoice = Array.isArray(raw) ? raw.find((i) => i?.id === id) : undefined;
+  if (!invoice) return false;
+  invoice.paid = true;
+  writeFileSync(file, `${JSON.stringify(raw, null, 2)}\n`);
+  return true;
+}
diff --git a/tests/mark-paid.test.ts b/tests/mark-paid.test.ts
new file mode 100644
index 0000000..7785c2b
--- /dev/null
+++ b/tests/mark-paid.test.ts
@@ -0,0 +1,39 @@
+import { copyFileSync, mkdtempSync, readFileSync } from 'node:fs';
+import type { Server } from 'node:http';
+import type { AddressInfo } from 'node:net';
+import { tmpdir } from 'node:os';
+import path from 'node:path';
+import { afterAll, beforeAll, describe, expect, it } from 'vitest';
+import { createApp } from '../src/app.js';
+
+// The app over a copy of the sample data, since marking an invoice paid writes the file.
+const file = path.join(mkdtempSync(path.join(tmpdir(), 'invoices-')), 'invoices.json');
+let server: Server;
+let base: string;
+
+beforeAll(async () => {
+  copyFileSync('data/invoices.json', file);
+  server = createApp({ invoicesFile: file, today: () => '2026-11-15' }).listen(0);
+  await new Promise((resolve) => server.once('listening', resolve));
+  base = `http://127.0.0.1:${(server.address() as AddressInfo).port}`;
+});
+afterAll(() => new Promise((resolve) => server.close(resolve)));
+
+describe('mark as paid', () => {
+  it('shows the button on an unpaid invoice only', async () => {
+    expect(await (await fetch(`${base}/invoices/INV-1002`)).text()).toContain('Mark as paid');
+    expect(await (await fetch(`${base}/invoices/INV-1001`)).text()).not.toContain('Mark as paid');
+  });
+
+  it('saves the payment in the file', async () => {
+    const res = await fetch(`${base}/invoices/INV-1002/paid`, { method: 'POST' });
+    expect(res.status).toBe(200);
+    const saved = JSON.parse(readFileSync(file, 'utf8'));
+    expect(saved.find((i: { id: string }) => i.id === 'INV-1002').paid).toBe(true);
+    expect(await (await fetch(`${base}/invoices/INV-1002`)).text()).toContain('status-paid');
+  });
+
+  it('answers 404 for an invoice that does not exist', async () => {
+    expect((await fetch(`${base}/invoices/INV-9999/paid`, { method: 'POST' })).status).toBe(404);
+  });
+});
