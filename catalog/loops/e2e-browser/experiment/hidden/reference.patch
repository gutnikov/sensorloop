+// The "Mark as paid" button of an unpaid invoice: saves the payment, then shows the invoice as paid, in place.
+const button = document.querySelector('#mark-paid');
+
+button?.addEventListener('click', async () => {
+  button.disabled = true;
+  const response = await fetch(`/invoices/${encodeURIComponent(button.dataset.invoice)}/paid`, { method: 'POST' });
+  if (!response.ok) {
+    button.disabled = false;
+    alert('The invoice could not be marked as paid. Please try again.');
+    return;
+  }
+  const badge = document.querySelector('#status .status');
+  badge.textContent = 'Paid';
+  badge.className = 'status status-paid';
+  button.closest('p').remove();
+});
