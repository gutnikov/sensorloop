-export function renderAging(report: AgingReport): string {
+/** The aging report; with details, each bucket's row is followed by its invoices, the longest overdue first. */
+export function renderAging(report: AgingReport, details = false): string {
   const count = report.buckets.reduce((n, b) => n + b.invoices.length, 0);
   const rows = [
     ['Overdue', 'Invoices', 'Amount'],
     ...report.buckets.map((b) => [b.label, String(b.invoices.length), formatMoney(b.amount)]),
     ['Total', String(count), formatMoney(report.total)],
   ];
-  return `As of ${report.today}\n\n${table(rows)}\n`;
+  const lines = table(rows).split('\n');
+  if (details) {
+    const listed = report.buckets.map((b) =>
+      b.entries.map((e) => [`  ${e.invoice.id}`, e.invoice.customer.name, `due ${e.invoice.dueOn}`, `${e.days} days`, formatMoney(e.amount)]),
+    );
+    const all = listed.flat();
+    const widths = all.length ? all[0].map((_, col) => Math.max(...all.map((row) => row[col].length))) : [];
+    const pad = (row: string[]) => row.map((cell, col) => (col < 3 ? cell.padEnd(widths[col]) : cell.padStart(widths[col]))).join('  ');
+    const out = [lines[0]];
+    report.buckets.forEach((_, i) => out.push(lines[i + 1], ...listed[i].map(pad)));
+    out.push(lines[lines.length - 1]);
+    return `As of ${report.today}\n\n${out.join('\n')}\n`;
+  }
+  return `As of ${report.today}\n\n${lines.join('\n')}\n`;
 }
diff --git a/tests/aging.test.ts b/tests/aging.test.ts
new file mode 100644
index 0000000..fc78719
--- /dev/null
+++ b/tests/aging.test.ts
@@ -0,0 +1,22 @@
+import { describe, expect, it } from 'vitest';
+import { aging } from '../src/report/aging.js';
+import { renderAging } from '../src/report/render.js';
+import type { Invoice } from '../src/types.js';
+
+function invoice(id: string, dueOn: string, amount: number): Invoice {
+  return { id, customer: { id: 'k', name: 'Kestrel' }, issuedOn: '2026-01-01', dueOn, items: [{ description: 'x', quantity: 1, unitPrice: amount }], taxRate: 0, paid: false };
+}
+
+describe('aging --details', () => {
+  const report = aging([invoice('A', '2026-10-20', 10), invoice('B', '2026-10-02', 20)], '2026-11-01');
+
+  it('lists the longest overdue first, under its bucket', () => {
+    const text = renderAging(report, true).split('\n');
+    expect(text.findIndex((l) => l.includes(' B '))).toBeLessThan(text.findIndex((l) => l.includes(' A ')));
+    expect(text.find((l) => l.includes(' B '))).toMatch(/due 2026-10-02\s+30 days\s+\$20\.00/);
+  });
+
+  it('prints the same report as before without details', () => {
+    expect(renderAging(report)).not.toContain('due 2026');
+  });
+});
