38;5;231m    \u001b[38;5;81mconst\u001b[38;5;231m \u001b[38;5;148mentry\u001b[38;5;231m: \u001b[38;5;148mAgingInvoice\u001b[38;5;231m = { invoice, days, \u001b[38;5;148mamount\u001b[38;5;231m: \u001b[38;5;148mtotals\u001b[38;5;231m(invoice).\u001b[39m\u001b[49m\u001b[K\r\u001b[1B     \u001b[38;5;77m\u001b[48;5;22m    +\u001b[38;5;231mtotal };                                                                 \u001b[49m\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;5;77m\u001b[48;5;22m 43 +\u001b[38;5;231m    buckets[BUCKETS.\u001b[38;5;148mfindIndex\u001b[38;5;231m((\u001b[38;5;208mb\u001b[38;5;231m) => days <= b.upTo)].invoices.\u001b[38;5;148mpush\u001b[38;5;231m(entry\u001b[39m\u001b[49m\u001b[K\r\u001b[1B     \u001b[38;5;77m\u001b[48;5;22m    +\u001b[38;5;231m);                                                                       \u001b[49m\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;5;231m\u001b[2m 44 \u001b[22m   }\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;5;167m\u001b[48;5;52m 36 -\u001b[38;5;231m  for (const bucket of buckets) bucket.amount = sumAmounts(bucket.invoice\u001b[49m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;167m\u001b[48;5;52m    -\u001b[38;5;231ms.map((i) => totals(i).total));                                          \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;5;77m\u001b[48;5;22m 45 +\u001b[38;5;231m  \u001b[38;5;197mfor\u001b[38;5;231m (\u001b[38;5;81mconst\u001b[38;5;231m bucket \u001b[38;5;197mof\u001b[38;5;231m buckets) {                                        \r\u001b[5C\u001b[1B\u001b[38;5;77m 46 +\u001b[38;5;231m    bucket.invoices.\u001b[38;5;148msort\u001b[38;5;231m((\u001b[38;5;208ma, b\u001b[38;5;231m) => b.days - a.days);                     \r\u001b[2C\u001b[1B\u001b[39m\u001b[49m   \u001b[38;5;77m\u001b[48;5;22m 47 +\u001b[38;5;231m    bucket.amount = \u001b[38;5;148msumAmounts\u001b[38;5;231m(bucket.invoices.\u001b[38;5;148mmap\u001b[38;5;231m((\u001b[38;5;208mentry\u001b[38;5;231m) => entry.amoun\u001b[39m\u001b[49m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;77m\u001b[48;5;22m    +\u001b[38;5;231mt));                                                                     \r\u001b[5C\u001b[1B\u001b[38;5;77m 48 +\u001b[38;5;231m  }                                                                      \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;5;231m\u001b[2m 49 \u001b[22m   \u001b[38;5;197mreturn\u001b[38;5;231m { today, buckets, \u001b[38;5;148mtotal\u001b[38;5;231m: \u001b[38;5;148msumAmounts\u001b[38;5;231m(buckets.\u001b[38;5;148mmap\u001b[38;5;231m((\u001b[38;5;208mb\u001b[38;5;231m) => b.amount)\r\u001b[5C\u001b[1B\u001b[2m    \u001b[22m ) };\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;231m\u001b[2m 50 \u001b[22m }\u001b[39m\u001b[K\u001b[34;1H\u001b[32;3H"]
