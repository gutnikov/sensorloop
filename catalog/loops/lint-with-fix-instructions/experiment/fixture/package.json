{
  "name": "invoicer",
  "version": "0.4.0",
  "private": true,
  "description": "Reports on a file of invoices: what was billed, what is overdue, and a CSV for spreadsheets.",
  "type": "module",
  "bin": {
    "invoicer": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "3.2.7"
  }
}
