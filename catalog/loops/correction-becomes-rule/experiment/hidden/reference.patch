diff --git a/tests/filter.test.ts b/tests/filter.test.ts
new file mode 100644
index 0000000..5e163c2
--- /dev/null
+++ b/tests/filter.test.ts
@@ -0,0 +1,41 @@
+import { describe, expect, it } from 'vitest';
+import { FilterError, select } from '../src/report/filter.js';
+import type { Invoice } from '../src/types.js';
+
+function invoice(id: string, customer: string, issuedOn: string): Invoice {
+  return {
+    id,
+    customer: { id: customer, name: customer.toUpperCase() },
+    issuedOn,
+    dueOn: issuedOn,
+    items: [{ description: 'work', quantity: 1, unitPrice: 100 }],
+    taxRate: 0,
+    paid: false,
+  };
+}
+
+const invoices = [invoice('1', 'acme', '2026-08-31'), invoice('2', 'birch', '2026-09-01'), invoice('3', 'acme', '2026-09-30')];
+
+describe('select', () => {
+  it('covers every invoice, and says nothing, with no filter', () => {
+    expect(select(invoices, {})).toEqual({ invoices, scope: [] });
+  });
+
+  it('keeps one customer, and says which', () => {
+    const { invoices: selected, scope } = select(invoices, { customer: 'acme' });
+    expect(selected.map((i) => i.id)).toEqual(['1', '3']);
+    expect(scope).toEqual(['Customer: ACME (acme)']);
+  });
+
+  it('keeps one month, and says which', () => {
+    const { invoices: selected, scope } = select(invoices, { month: '2026-09' });
+    expect(selected.map((i) => i.id)).toEqual(['2', '3']);
+    expect(scope).toEqual(['Month: 2026-09']);
+  });
+
+  it('names a customer no invoice has, and a month not written as YYYY-MM', () => {
+    expect(() => select(invoices, { customer: 'nobody' })).toThrow(FilterError);
+    expect(() => select(invoices, { customer: 'nobody' })).toThrow('nobody');
+    expect(() => select(invoices, { month: '2026-9' })).toThrow('2026-9');
+  });
+});
