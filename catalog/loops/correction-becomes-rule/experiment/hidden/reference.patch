diff --git a/src/report/filter.ts b/src/report/filter.ts
new file mode 100644
index 0000000..ad9a780
--- /dev/null
+++ b/src/report/filter.ts
@@ -0,0 +1,37 @@
+import type { Invoice } from '../types.js';
+
+/** A filter that cannot apply, such as a customer no invoice has. Reported to the user as it is. */
+export class FilterError extends Error {}
+
+export interface Filters {
+  /** A customer's id in the file, such as `acme`. */
+  customer?: string;
+  /** YYYY-MM: the invoices issued in that month. */
+  month?: string;
+}
+
+/** The invoices a report covers, and the lines at its top that say what it covers (none when it covers them all). */
+export interface Selection {
+  invoices: Invoice[];
+  scope: string[];
+}
+
+const MONTH = /^\d{4}-(0[1-9]|1[0-2])$/;
+
+export function select(invoices: Invoice[], filters: Filters): Selection {
+  let selected = invoices;
+  const scope: string[] = [];
+  if (filters.customer !== undefined) {
+    const id = filters.customer;
+    selected = selected.filter((invoice) => invoice.customer.id === id);
+    if (selected.length === 0) throw new FilterError(`no invoices for customer ${id}`);
+    scope.push(`Customer: ${selected[0].customer.name} (${id})`);
+  }
+  if (filters.month !== undefined) {
+    const month = filters.month;
+    if (!MONTH.test(month)) throw new FilterError(`expected a month as YYYY-MM: ${month}`);
+    selected = selected.filter((invoice) => invoice.issuedOn.startsWith(`${month}-`));
+    scope.push(`Month: ${month}`);
+  }
+  return { invoices: selected, scope };
+}
