[0.02,"o","\u001b[H\r\u001b[1B\u001b[K\r\u001b[1B\u001b[48;5;237m\u001b[38;5;246m❯ \u001b[38;5;231mPlease implement this issue.\u001b[39m                                                            \r\u001b[1B                                                                                          \r\u001b[1B  \u001b[38;5;231m#21 Filter the reports by customer\u001b[39m                                                      \r\u001b[1B                                                                                          \r\u001b[1B  \u001b[38;5;231mWh\u001b[6Gn I\u001b[10Gtalk to one customer I only want their invoices. Add \u001b[38;5;153m--customer <id>\u001b[38;5;231m to \u001b[38;5;153minvoicer\r\u001b[2C\u001b[1Bsummary\u001b[38;5;231m and \u001b[38;5;153minvoicer aging\u001b[38;5;231m: with it, the report covers only that customer's invoices. \r\u001b[2C\u001b[1BThe\u001b[7Gid is the cust\u001b[22Gmer's \u001b[38;5;153mid\u001b[38;5;231m in the file, such as \u001b[38;5;153macme\u001b[38;5;231m.\r\u001b[2C\u001b[2B- Without \u001b[38;5;153m--customer\u001b[38;5;231m, \u001b[26Ghe \u001b[30Geports pri\u001b[43Gexactly what they print today.\u001b[39m                 \r\u001b[2C\u001b[1B\u001b[38;5;231m- An id\u001b[11Gthat no invoice has\u001b[31Gis an error that names the\u001b[58Gid.\u001b[39m                            \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;5;231m●\u001b[39m I'll start by exploring the codebase.\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246m \u001b[39m Capturing current report output\u001b[K\r\u001b[1B\u001b[38;5;246m  ⎿  \u001b[39m\u001b[2m\u001b[3mNow write filter.ts and update cli.ts, tests, README maybe. Let's think about usage \r\u001b[1B\u001b[23m\u001b[22m \u001b[3G   \u001b[2m\u001b[3mline formatting: \u001b[38;5;153minvoicer summary <file> [--customer ID] billed... invoicer aging \r\u001b[5C\u001b[1B<file> [--today YYYY-MM-DD] [--customer ID] overdue...\u001b[39m Need alignment. Fine. Now \r\u001b[1B\u001b[23m\u001b[22m \u001b[3G   \u001b[2m\u001b[3moption parsing. Let's write a helper: \u001b[38;5;153mts /** The value after `--name`, or undefined \r\u001b[1B\u001b[23m\u001b[22m\u001b[39m     \u001b[38;5;153m\u001b[2m\u001b[3mif the flag is not given. */ function option(args: string[], name: string): string | \r\u001b[5C\u001b[1Bundefined { const at = args.indexOf(name); if (at < 0) return undefined; const value \r\u001b[5C\u001b[1B= args[at + 1]; if (value === undefined || value.startsWith('--')) { throw new \r\u001b[5C\u001b[1BUsageError(`${name} needs a value`); } return value; } \u001b[39m Should missing option value \r\u001b[5C\u001b[1Bgo through UsageError catch. Add class and catch. Or we could not throw and simply \r\u001b[5C\u001b[1Breturn undefined; not ideal. Let's implement UsageError. But note:…\r\u001b[2B\u001b[23m\u001b[22m\u001b[38;5;174m✢\u001b[36G\u001b[38;5;246mthought for 4s)\u001b[39m\u001b[34;1H\u001b[32;3H"]
