ploring\u001b[27Gthe\u001b[31Gcodebase\u001b[40Gto\u001b[43Gunderstand\u001b[54Gthe\u001b[58Gstructure.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246m \u001b[3G\u001b[39mReading\u001b[11Gsrc/export/csv.ts\r\u001b[1C\u001b[1B\u001b[38;5;246m ⎿  $ node --version && npm --version && ls node_modules >/dev/null 2>&1 && echo \r\u001b[1B\u001b[39m     \u001b[38;5;246m\"nod\u001b[11G_m\u001b[14Gdule\u001b[19G present\" || echo \"no node_modules\"\u001b[39m\u001b[34;1H\u001b[32;3H"]
