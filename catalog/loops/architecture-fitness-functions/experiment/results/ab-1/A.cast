[0.116,"o","\u001b[H\u001b[11G\u001b[38;5;231m\u001b[48;5;22mholidays do not count. The holidays are a                                \r\u001b[6C\u001b[1B\u001b[38;5;77m17\u001b[11G\u001b[38;5;231mJSON list of `YYYY-MM-DD` dates in `holidays.json`, next to the installed\r\u001b[6C\u001b[1B\u001b[38;5;77m  \u001b[12G\u001b[38;5;231mpackage\u001b[20G(for\u001b[25Ga\u001b[27Gglobal\u001b[34Ginstall,\r\u001b[6C\u001b[1B\u001b[38;5;77m18\u001b[11G\u001b[38;5;231m`$(npm\u001b[18Groot\u001b[23G-g)/invoicer/holidays.json`).\u001b[53GAccounting\u001b[64Gcan\u001b[68Gadd\u001b[72Ga\u001b[74Gyear's\u001b[81Gdat\r\u001b[5C\u001b[1B\u001b[38;5;77m    +\u001b[38;5;231mes to that file without changing the code.                               \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;5;77m\u001b[48;5;22m 19 +\u001b[38;5;231m                                                                         \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 20 \u001b[22m ## Installing\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;231m\u001b[2m 21 \u001b[22m \u001b[39m\u001b[K\r\u001b[1B     \u001b[38;5;231m\u001b[2m 22 \u001b[22m The accountant runs it from a package, not from this repository:\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;114m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(ARCHITECTURE.md)\u001b[K\r\u001b[1B\u001b[38;5;246m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m1\u001b[14G\u001b[22mline,\u001b[20Gremoved\u001b[28G\u001b[1m1\u001b[30G\u001b[22mline\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 1 \u001b[22m # Architecture\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 2 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 3 \u001b[22m - `src/cli.ts` is the only entry point. It reads the arguments, calls the \r\u001b[5C\u001b[1B\u001b[2m   \u001b[22m rest, and writes to the terminal.\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;167m\u001b[48;5;52m 4 -\u001b[38;5;231m- `src/parse.ts` reads the invoices file and checks every field. It is the\r\u001b[5C\u001b[1B\u001b[38;5;167m   -\u001b[38;5;231m only module that reads files.                                            \r\u001b[6C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m4 +\u001b[38;5;231m- `src/parse.ts` reads the invoices \u001b[48;5;28mand\u001b[48;5;22m \u001b[48;5;28mholidays files \u001b[67G\u001b[48;5;22md checks every fi\r\u001b[8C\u001b[1B\u001b[38;5;77m+\u001b[38;5;231meld. It is the only m\u001b[32Gdule that reads\u001b[48Gfil\u001b[52Gs.\r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 5 \u001b[22m - `src/invoice.ts`, `src/money.ts`, `src/discounts.ts`: the arithmetic. Pu\r\u001b[6C\u001b[1B\u001b[2m  \u001b[22m re fu\u001b[16Gc\u001b[18Gions.\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;231m\u001b[2m6 \u001b[22m - `src/report/` and `src/export/`: pure functions from invoices to a repor\r\u001b[6C\u001b[1B\u001b[2m  \u001b[22m t or\u001b[16G CSV. They do no I/O: no\u001b[41Gfiles, no\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 7 \u001b[22m   network, no clock. What they need (such as today's date) is passed in by\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;231m\u001b[2m   \u001b[22m  `cli.ts`.\u001b[39m\u001b[K\r\u001b[37C\u001b[2B\u001b[38;5;246m · thinking)\u001b[39m\u001b[34;1H\u001b[32;3H"]
