+
+// The public holidays, which the aging report skips when it counts business days.
+/** A problem with the holidays file, reported to the user as it is. */
+export class HolidayFileError extends Error {}
+
+/** The holidays file at the root of the package: `../holidays.json` from both `src/` and `dist/`. */
+const PACKAGE_PATH = join(dirname(fileURLToPath(import.meta.url)), '..', 'holidays.json');
+
+/** A JSON list of YYYY-MM-DD dates, as public holidays. */
+export function parseHolidays(json: string): Set<string> {
+  let data: unknown;
+  try {
+    data = JSON.parse(json);
+  } catch (error) {
+    throw new HolidayFileError(`not JSON: ${(error as Error).message}`);
+  }
+  if (!Array.isArray(data)) throw new HolidayFileError('expected a list of dates');
+  return new Set(
+    data.map((value, i) => {
+      if (typeof value !== 'string' || !DATE.test(value)) {
+        throw new HolidayFileError(`#${i + 1}: expected a date as YYYY-MM-DD`);
+      }
+      return value;
+    }),
+  );
+}
+
+/** Read the holiday list that ships with the package, so accounting can update it without a rebuild. */
+export function readHolidays(path = PACKAGE_PATH): Set<string> {
+  let json: string;
+  try {
+    json = readFileSync(path, 'utf8');
+  } catch (error) {
+    throw new HolidayFileError(`cannot read ${path}: ${(error as Error).message}`);
+  }
+  try {
+    return parseHolidays(json);
+  } catch (error) {
+    throw new HolidayFileError(`${path}: ${(error as Error).message}`);
+  }
+}
