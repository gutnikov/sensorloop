@@ -0,0 +1,31 @@
+import { describe, expect, it } from 'vitest';
+import { businessDaysBetween } from '../src/businessDays.js';
+
+const NONE = new Set<string>();
+const HOLIDAYS = new Set(['2026-01-01', '2026-10-12', '2026-11-11', '2026-11-26', '2026-12-25']);
+
+describe('businessDaysBetween', () => {
+  it('does not count the due date itself', () => {
+    expect(businessDaysBetween('2026-11-06', '2026-11-06', NONE)).toBe(0);
+  });
+
+  it('counts a Friday as 1 business day overdue on the next Monday', () => {
+    expect(businessDaysBetween('2026-11-06', '2026-11-09', NONE)).toBe(1);
+  });
+
+  it('skips weekends', () => {
+    expect(businessDaysBetween('2026-11-09', '2026-11-16', NONE)).toBe(5);
+  });
+
+  it('skips public holidays', () => {
+    // Veterans Day (Wednesday) falls in this week.
+    expect(businessDaysBetween('2026-11-09', '2026-11-16', HOLIDAYS)).toBe(4);
+  });
+
+  it('skips holidays that land on weekdays', () => {
+    // Thanksgiving and the day after; Christmas across a weekend; New Year's Day.
+    expect(businessDaysBetween('2026-11-25', '2026-11-27', HOLIDAYS)).toBe(1);
+    expect(businessDaysBetween('2026-12-24', '2026-12-28', HOLIDAYS)).toBe(1);
+    expect(businessDaysBetween('2025-12-31', '2026-01-02', HOLIDAYS)).toBe(1);
+  });
+});
