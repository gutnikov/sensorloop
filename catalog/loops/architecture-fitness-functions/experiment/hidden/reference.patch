@@ -0,0 +1,16 @@
+const DAY = 24 * 60 * 60 * 1000;
+
+function isoDate(time: number): string {
+  return new Date(time).toISOString().slice(0, 10);
+}
+
+/** Business days after `from` up to and including `to`. Weekends and public holidays do not count. */
+export function businessDaysBetween(from: string, to: string, holidays: ReadonlySet<string>): number {
+  const end = Date.parse(to);
+  let days = 0;
+  for (let time = Date.parse(from) + DAY; time <= end; time += DAY) {
+    const weekday = new Date(time).getUTCDay();
+    if (weekday !== 0 && weekday !== 6 && !holidays.has(isoDate(time))) days++;
+  }
+  return days;
+}
