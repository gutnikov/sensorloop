@@ -0,0 +1,41 @@
+import { describe, expect, it } from 'vitest';
+import { aging } from '../src/report/aging.js';
+import type { Invoice } from '../src/types.js';
+
+function invoice(id: string, dueOn: string, paid = false): Invoice {
+  return {
+    id,
+    customer: { id: 'acme', name: 'Acme Tools' },
+    issuedOn: '2026-01-01',
+    dueOn,
+    items: [{ description: 'work', quantity: 1, unitPrice: 100 }],
+    taxRate: 0,
+    paid,
+  };
+}
+
+const HOLIDAYS = new Set(['2026-09-07', '2026-10-12', '2026-11-11', '2026-11-26', '2026-12-25']);
+
+function bucketOf(report: ReturnType<typeof aging>, id: string): string | undefined {
+  return report.buckets.find((bucket) => bucket.invoices.some((i) => i.id === id))?.label;
+}
+
+describe('aging', () => {
+  it('groups by business days, not calendar days', () => {
+    // Due Monday 2026-08-31. On Monday 2026-11-16 that is 77 calendar days, but 52 business
+    // days once weekends, Labor Day, Columbus Day and Veterans Day are skipped: 31-60 days.
+    const report = aging([invoice('old', '2026-08-31')], '2026-11-16', HOLIDAYS);
+    expect(bucketOf(report, 'old')).toBe('31-60 days');
+  });
+
+  it('counts the Monday after a Friday due date as 1 business day', () => {
+    const report = aging([invoice('friday', '2026-10-30')], '2026-11-02', HOLIDAYS);
+    expect(bucketOf(report, 'friday')).toBe('1-30 days');
+  });
+
+  it('leaves out paid invoices', () => {
+    const report = aging([invoice('paid', '2026-10-01', true)], '2026-11-16', HOLIDAYS);
+    expect(report.buckets.every((bucket) => bucket.invoices.length === 0)).toBe(true);
+    expect(report.total).toBe(0);
+  });
+});
