+import { describe, expect, it } from 'vitest';
+import { HolidayFileError, parseHolidays, readHolidays } from '../src/parse.js';
+
+describe('parseHolidays', () => {
+  it('reads a list of dates', () => {
+    expect([...parseHolidays('["2026-01-01", "2026-12-25"]')]).toEqual(['2026-01-01', '2026-12-25']);
+  });
+
+  it('names what is wrong', () => {
+    expect(() => parseHolidays('{}')).toThrow(new HolidayFileError('expected a list of dates'));
+    expect(() => parseHolidays('["01/01/2026"]')).toThrow('expected a date as YYYY-MM-DD');
+    expect(() => parseHolidays('[')).toThrow('not JSON');
+  });
+});
+
+describe('readHolidays', () => {
+  it('reads the holidays file that ships with the package', () => {
+    const holidays = readHolidays();
+    expect(holidays.has('2026-01-01')).toBe(true);
+    expect(holidays.has('2026-11-26')).toBe(true);
+    expect(holidays.has('2026-12-25')).toBe(true);
+    expect(holidays.size).toBe(11);
+  });
+});
