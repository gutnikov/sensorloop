{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.sensorloop/hooks/check.sh --on-git-commit architecture '.sensorloop/hooks/architecture.sh'",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.sensorloop/hooks/guard-rules.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.sensorloop/hooks/check.sh architecture '.sensorloop/hooks/architecture.sh'",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.sensorloop/hooks/check.sh architecture '.sensorloop/hooks/architecture.sh'",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
