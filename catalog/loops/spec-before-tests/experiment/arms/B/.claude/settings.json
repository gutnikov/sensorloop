{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.sensorloop/hooks/trace.mjs 'AC[0-9]+'",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.sensorloop/hooks/trace.mjs 'AC[0-9]+'",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
