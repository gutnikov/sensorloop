+import { describe, expect, it } from 'vitest';
+import { invoice, runCli, writeInvoices } from './helpers/cli.js';
+
+// #58 A reminder list for accounting. Today is 2026-11-02 in every test.
+const HEADER = 'invoice,customer,due_on,days_overdue,amount';
+const remind = (invoices: object[]) => {
+  const r = runCli('reminders', writeInvoices(invoices), '--today', '2026-11-02');
+  expect(r.status).toBe(0);
+  return r.stdout.trimEnd().split('\n');
+};
+
+describe('invoicer reminders', () => {
+  it('AC1: lists unpaid invoices due before today, and no others', () => {
+    const lines = remind([
+      invoice({ id: 'A-1', customer: 'Alder', dueOn: '2026-10-30', amount: 100 }),
+      invoice({ id: 'A-2', customer: 'Alder', dueOn: '2026-11-02', amount: 100 }),
+      invoice({ id: 'B-1', customer: 'Birch', dueOn: '2026-10-01', amount: 100, paid: true }),
+    ]);
+    expect(lines.slice(1).map((l) => l.split(',')[0])).toEqual(['A-1']);
+  });
+
+  it('AC2: has the header, and the columns in their order', () => {
+    const lines = remind([invoice({ id: 'A-1', customer: 'Alder Works', dueOn: '2026-10-30', amount: 1250.5 })]);
+    expect(lines).toEqual([HEADER, 'A-1,Alder Works,2026-10-30,3,1250.50']);
+  });
+
+  it('AC3: lists the most overdue first, and ties by id', () => {
+    const lines = remind([
+      invoice({ id: 'C-2', customer: 'Cedar', dueOn: '2026-10-20', amount: 10 }),
+      invoice({ id: 'A-1', customer: 'Alder', dueOn: '2026-10-30', amount: 10 }),
+      invoice({ id: 'C-1', customer: 'Cedar', dueOn: '2026-10-20', amount: 10 }),
+      invoice({ id: 'B-1', customer: 'Birch', dueOn: '2026-09-15', amount: 10 }),
+    ]);
+    expect(lines.slice(1).map((l) => l.split(',')[0])).toEqual(['B-1', 'C-1', 'C-2', 'A-1']);
+  });
+
+  it('AC4: leaves out an invoice more than 90 days overdue, and keeps one at 90 days', () => {
+    const lines = remind([
+      invoice({ id: 'A-1', customer: 'Alder', dueOn: '2026-08-04', amount: 10 }),
+      invoice({ id: 'B-1', customer: 'Birch', dueOn: '2026-08-03', amount: 10 }),
+    ]);
+    expect(lines.slice(1).map((l) => l.split(',').slice(0, 4).join(','))).toEqual(['A-1,Alder,2026-08-04,90']);
+  });
+
+  it('AC4, as accounting answered: leaves out every invoice of a customer at the agency', () => {
+    const lines = remind([
+      invoice({ id: 'A-1', customer: 'Alder', dueOn: '2026-07-01', amount: 10 }),
+      invoice({ id: 'A-2', customer: 'Alder', dueOn: '2026-10-20', amount: 10 }),
+      invoice({ id: 'B-1', customer: 'Birch', dueOn: '2026-10-20', amount: 10 }),
+    ]);
+    expect(lines.slice(1).map((l) => l.split(',')[0])).toEqual(['B-1']);
+  });
+
+  it('AC5: prints the header alone when there is nothing to remind', () => {
+    expect(remind([invoice({ id: 'A-1', customer: 'Alder', dueOn: '2026-12-01', amount: 10 })])).toEqual([HEADER]);
+  });
+});
