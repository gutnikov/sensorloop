[0.104,"o","\u001b[H\u001b[3GThe review also surfaced a related gap: the chip\u001b[52Gis only\u001b[60Grendered when the Permissions\r\u001b[2C\u001b[1BAPI r\u001b[9Gports \u001b[38;5;153mprompt\u001b[39m, a\u001b[25Gd WebKit only added\u001b[45Gthat\u001b[50GAPI\u001b[54Gin\u001b[57GiOS\u001b[61G16\u001b[64Gwhile\u001b[70Gthe\u001b[74Gapp's\u001b[80Gdeployment\r\u001b[2C\u001b[1Btarget\u001b[10Gis\u001b[13GiOS\u001b[17G15\u001b[20G—\u001b[22Gso\u001b[25Gon\u001b[28Golder\u001b[34Gdevices\u001b[42Gthe\u001b[46Gbutton\u001b[53Gwas\u001b[57Gunreachable\u001b[69Geven\u001b[74Gwith\u001b[79Gthe\u001b[83Gplist\r\u001b[2C\u001b[1Bkey.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mChanges (2 commits on \u001b[38;5;153mmaster\u001b[39m)\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;5;153mpackages/mobile-client/ios/App/App/Info.plist\u001b[51G\u001b[39m—\u001b[53Gdeclare\r\u001b[2C\u001b[1B  \u001b[38;5;153mNSLocationWhenInUseUsageDescription\u001b[41G\u001b[39mwith\u001b[46Ga\u001b[48Guser-facing\u001b[60Gpurpose\u001b[68Gstring.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;5;153mpackages/mobile-client/android/app/src/main/AndroidManifest.xml\u001b[69G\u001b[39m—\u001b[71Gdeclare\u001b[79Gcoarse\u001b[86Gand\r\u001b[2C\u001b[1B \u001b[5Gfine location permissions.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;5;153mpackages/desktop-client/src/hooks/useLocationPermission.ts\u001b[39m — treat an\u001b[K\r\u001b[2C\u001b[1B \u001b[5Gunavailable/failed permission query as \"undecided\" rather than \"no a\u001b[74Gcess\", so the\u001b[K\r\u001b[4C\u001b[1BRequest Location chip is offered\u001b[38Gand\u001b[42Ghides\u001b[48Gonly\u001b[53Gafter\u001b[59Ga\u001b[61Grequest\u001b[69Gactually\u001b[78Gfails.\r\u001b[61C\u001b[1B\u001b[38;5;153mest.ts\u001b[39m — 7 tests\u001b[79Gcovering\r\u001b[4C\u001b[1Bmissing API, rej\u001b[22Gcted query, prompt/grante\u001b[48G states, successful\u001b[68Ga\u001b[70Gd\u001b[72Gfailed requests