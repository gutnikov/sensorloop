[0.194,"o","\u001b[H\r\u001b[1B  \u001b[38;5;246mThought for \u001b[1m11s\u001b[22m, read \u001b[1m1\u001b[22m file, listed \u001b[1m1\u001b[22m directory, ran \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;231m●\u001b[3G\u001b[39mThe\u001b[7Gissue\u001b[13Gis\u001b[16Gfixed,\u001b[23Gtested,\u001b[31Gand\u001b[35Gboth\u001b[40Greview\u001b[47Grounds\u001b[54Gare\u001b[58Gapproved.\u001b[68GHere's\u001b[75Gthe\u001b[79Gsummary.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mRoot cause\r\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7GiOS\u001b[11Gapp's\u001b[17G\u001b[38;5;153mInfo.plist\u001b[28G\u001b[39mnever\u001b[34Gdeclared\u001b[43G\u001b[38;5;153mNSLocationWhenInUseUsageDescription\u001b[39m.\u001b[80GWebKit\u001b[87Gwill\r\u001b[2C\u001b[1Bnot show a\u001b[14Glocation\u001b[23Gpermission\u001b[34Gprompt\u001b[41G(and\u001b[46Gdenies\u001b[53Gthe\u001b[57Grequest)\u001b[66Gfor\u001b[70Gan\u001b[73Gapp\u001b[77Gwithout\u001b[85Git,\r\u001b[2C\u001b[1Bso\u001b[6Gtapping\u001b[14Gthe\u001b[18Gpayee\u001b[24Gfield's\u001b[32G\u001b[1mRequest Location\u001b[49G\u001b[22mchip\u001b[54Gsilently\u001b[63Gdid\u001b[67Gnothing\u001b[75Gin\u001b[78Gthe\r\u001b[3C\u001b[1BestFlight build. Android had th\u001b[36G s\u001b[39Gm\u001b[41G gap: Capacitor's WebView asks for\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;153mACCESS_COARSE_LOCATION\u001b[39m/\u001b[38;5;153mACCESS_FINE_LOCATION\u001b[39m, but neither wa\u001b[63G declared\u001b[73Gin the manifest,\r\u001b[6C\u001b[1Bhe request\u001b[18Gw\u001b[20Gs den\u001b[27Gd immediately.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe review also surfaced a related gap: the chip\u001b[52Gis only\u001b[60Grendered when the Permissions\r\u001b[2C\u001b[1BAPI r\u001b[9Gports \u001b[38;5;153mprompt\u001b[39m, a\u001b[25Gd WebKit only added\u001b[45Gthat\u001b[50GAPI\u001b[54Gin\u001b[57GiOS\u001b[61G16\u001b[64Gwhile\u001b[70Gthe\u001b[74Gapp's\u001b[80Gdeployment\r\u001b[2C\u001b[1Btarget\u001b[10Gis\u001b[13GiOS\u001b[17G15\u001b[20G—\u001b[22Gso\u001b[25Gon\u001b[28Golder\u001b[34Gdevices\u001b[42Gthe\u001b[46Gbutton\u001b[53Gwas\u001b[57Gunreachable\u001b[69Geven\u001b[74Gwith\u001b[79Gthe\u001b[83Gplist\r\u001b[2C\u001b[1Bkey.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mChanges (2 commits on \u001b[38;5;153mmaster\u001b[39m)\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;5;153mpackages/mobile-client/ios/App/App/Info.plist\u001b[51G\u001b[39m—\u001b[53Gdeclare\r\u001b[2C\u001b[1B  \u001b[38;5;153mNSLocationWhenInUseUsageDescription\u001b[41G\u001b[39mwith\u001b[46Ga\u001b[48Guser-facing\u001b[60Gpurpose\u001b[68Gstring.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;5;153mpackages/mobile-client/android/app/src/main/AndroidManifest.xml\u001b[69G\u001b[39m—\u001b[71Gdeclare\u001b[79Gcoarse\u001b[86Gand\r\u001b[2C\u001b[1B \u001b[5Gfine location permissions.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;5;153mpackages/desktop-client/src/hooks/useLocationPermission.ts\u001b[39m — treat an\u001b[K\r\u001b[2C\u001b[1B \u001b[5Gunavailable/failed permission query as \"undecided\" rather than \"no a\u001b[74Gcess\", so the\u001b[K\r\u001b[4C\u001b[1BRequest Location chip is offered\u001b[38Gand\u001b[42Ghides\u001b[48Gonly\u001b[53Gafter\u001b[59Ga\u001b[61Grequest\u001b[69Gactually\u001b[78Gfails.\r\u001b[4C\u001b[1B\u001b[K\u001b[34;1H\u001b[32;3H"]
[0.108,"o","\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;231m●\u001b[3G\u001b[39mThe\u001b[7Gissue\u001b[13Gis\u001b[16Gfixed,\u001b[23Gtested,\u001b[31Gand\u001b[35Gboth\u001b[40Greview\u001b[47Grounds\u001b[54Gare\u001b[58Gapproved.\u001b[68GHere's\u001b[75Gthe\u001b[79Gsummary.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mRoot cause\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7GiOS\u001b[11Gapp's\u001b[17G\u001b[38;5;153mInfo.plist\u001b[28G\u001b[39mnever\u001b[34Gdeclared\u001b[43G\u001b[38;5;153mNSLocationWhenInUseUsageDescription\u001b[39m.\u001b[80GWebKit\u001b[87Gwill\r\u001b[2C\u001b[1Bnot\u001b[7Gshow a location permission\u001b[34Gprompt (and denies the request) for an app without it,\u001b[K\r\u001b[2C\u001b[1Bs\u001b[5G tapping\u001b[14Gthe payee field's \u001b[1mRequest Location\u001b[22m chip silently did nothing in the\u001b[K\r\u001b[2C\u001b[1BTes\u001b[7GFlight\u001b[14Gbuild. Android had the same gap: Capacitor's WebView\u001b[67Gasks for\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;153mACCESS_COARSE_LOCATION\u001b[39m/\u001b[38;5;153mACCESS_FINE_LOCATION\u001b[39m, but neither was declared in\u001b[76Gthe\u001b[80Gmanifest,\r\u001b[2C\u001b[1Bso the request was denied immediately.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Greview\u001b[14Galso\u001b[19Gsurfaced\u001b[28Ga\u001b[30Grelated\u001b[38Ggap:\u001b[43Gthe\u001b[47Gchip\u001b[52Gis\u001b[55Gonly\u001b[60Grendered\u001b[69Gwhen\u001b[74Gthe\u001b[78GPermissions\r\u001b[2C\u001b[1BAPI\u001b[9Gports \u001b[38;5;153mprompt\u001b[39m, \u001b[24Gnd WebKit only \u001b[40Gdded that API in iOS 16 while the\u001b[74Gapp's deployment\r\u001b[2C\u001b[1Btarget is iOS 15 — so on older\u001b[34Gdevices the bu\u001b[49Gton was\u001b[57Gunreachable even\u001b[74Gwith th\u001b[82G plist\u001b[K\r\u001b[2C\u001b[1Bkey.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mChanges (2 commits on \u001b[38;5;153mmaster\u001b[39m)\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;5;153mpackages/mobile-client/ios/App/App/Info.plist\u001b[51G\u001b[39m—\u001b[53Gdeclare\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;5;153mNSLocationWhenInUseUsageDescription\u001b[39m with a user-fa\u001b[56Ging purpose\u001b[68Gstring.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;5;153mpackages/mobile-client/android/app/src/main/AndroidManifest.xml\u001b[39m — declare\u001b[79Gcoarse\u001b[86Gand\r\u001b[2C\u001b[1B \u001b[5Gfine location permissions.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;5;153mpackages/desktop-client/src/hooks/useLocationPermission.ts\u001b[64G\u001b[39m—\u001b[66Gtreat\u001b[72Gan\r\u001b[2C\u001b[1B \u001b[5Gunavailable/failed permission query as \"undecided\" rather than \"no\u001b[73Gccess\",\u001b[81Gso\u001b[84Gthe\r\u001b[4C\u001b[1BRequest Location chip is offered and hides only after a \u001b[62Gequest actually fails.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;5;153mpackages/desktop-client/src/hooks/useLocationPermission.test.ts\u001b[69G\u001b[39m— 7 tests covering\r\u001b[2C\u001b[1B \u001b[5Gmissing\u001b[13GAPI,\u001b[18Grejected\u001b[27Gquery,\u001b[34Gprompt/granted\u001b[49Gstates,\u001b[57Gsuccessful\u001b[68Gand\u001b[72Gfailed\u001b[79Grequests,\u001b[34;1H\u001b[32;3H"]
[0.114,"o","\u001b[H\u001b[3GThe\u001b[7GiOS\u001b[11Gapp's\u001b[17G\u001b[38;5;153mInfo.plist\u001b[28G\u001b[39mnever\u001b[34Gdeclared\u001b[43G\u001b[38;5;153mNSLocationWhenInUseUsageDescription\u001b[39m.\u001b[80GWebKit\u001b[87Gwill\r\u001b[2C\u001b[1Bnot\u001b[7Gshow\u001b[12Ga\u001b[14Glocation\u001b[23Gpermission\u001b[34Gprompt\u001b[41G(and\u001b[46Gdenies\u001b[53Gthe\u001b[57Grequest)\u001b[66Gfor\u001b[70Gan\u001b[73Gapp\u001b[77Gwithout\u001b[85Git,\r\u001b[1B \u001b[3Gso tapping the payee fiel\u001b[29G's \u001b[1mRequest Location\u001b[22m chip\u001b[54Gsilently di\u001b[66G nothing\u001b[75Gin the\u001b[K\r\u001b[2C\u001b[1BTestFlight\u001b[14Gbuild.\u001b[21GAndroid\u001b[29Ghad\u001b[33Gthe\u001b[37Gsame\u001b[42Ggap:\u001b[47GCapacitor's\u001b[59GWebView\u001b[67Gasks\u001b[72Gfor\r\u001b[2C\u001b[1B\u001b[38;5;153mACCESS_COARSE_LOCATION\u001b[39m/\u001b[38;5;153mACCESS_FINE_LOCATION\u001b[39m,\u001b[48Gbut\u001b[52Gneither\u001b[60Gwas\u001b[64Gdeclared\u001b[73Gin\u001b[76Gthe\u001b[80Gmanifest,\r\u001b[2C\u001b[1Bso\u001b[6Gthe\u001b[10Grequest\u001b[18Gwas\u001b[22Gdenied\u001b[29Gimmediately.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Greview\u001b[14Galso surfaced a related gap: the ch\u001b[50Gp is only r\u001b[62Gndered when the Permiss\u001b[86Gons\r\u001b[2C\u001b[1BAPI re\u001b[10Gorts \u001b[38;5;153mprompt\u001b[39m, and WebKit only added that API\u001b[54Gin iOS 16 while the app's deployment\r\u001b[2C\u001b[1Btarget is iOS 15 — so \u001b[26Gn older d\u001b[36Gvices\u001b[42Gthe button was unr\u001b[61Gachable even with\u001b[79Gthe\u001b[83Gplist\r\u001b[2C\u001b[1Bkey.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mChanges (2 commits on \u001b[38;5;153mmaster\u001b[39m)\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B- \u001b[38;5;153mpackages/mobile-client/ios/App/App/Info.plist\u001b[39m — declare\u001b[61G\u001b[K\r\u001b[2C\u001b[1B  \u001b[38;5;153mNSLocationWhenInUseUsageDescription\u001b[39m with\u001b[46Ga user-f\u001b[55Gcing purpose stri\u001b[73Gg.\u001b[K\r\u001b[2C\u001b[1B- \u001b[38;5;153mpackages/mobile-client/android/app/src/main/AndroidManifest.xml\u001b[69G\u001b[39m—\u001b[71Gdeclare\u001b[79Gcoarse\u001b[86Gand\r\u001b[4C\u001b[1Bfine\u001b[10Glocation\u001b[19Gpermissions.\r\u001b[2C\u001b[1B- \u001b[38;5;153mpackages/desktop-client/src/hooks/useLocationPermission.ts\u001b[64G\u001b[39m—\u001b[66Gtreat\u001b[72Gan\r\u001b[4C\u001b[1Bunavailable/failed\u001b[24Gpermission\u001b[35Gquery\u001b[41Gas\u001b[44G\"undecided\"\u001b[56Grather\u001b[63Gthan\u001b[68G\"no\u001b[72Gaccess\",\u001b[81Gso\u001b[84Gthe\r\u001b[2C\u001b[1B \u001b[5GRequest Location chip is offered and hides only\u001b[53Gafter a\u001b[61Grequest\u001b[69Gactually\u001b[78Gfails.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;5;153mpackages/desktop-client/src/hooks/useLocationPermission.test.ts\u001b[39m — 7 tests\u001b[79Gcovering\r\u001b[2C\u001b[1B \u001b[5Gmissing API, rejected query, prompt/granted states, successful and failed\u001b[79Grequests,\u001b[K\r\u001b[4C\u001b[1Band wide-screen behav\u001b[28Gr.\u001b[K\r\u001b[4C\u001b[1B\u001b[38;5;153mup\u001b[8Goming-r\u001b[16Glease\u001b[22Gnot\u001b[26Gs/fix-mobile-payee-location-request.md\u001b[39m — bugfix release\u001b[82Gnote.\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mVerification\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[K\u001b[34;1H\u001b[32;3H"]
[0.102,"o","\u001b[H\u001b[3Gso tapping the payee field's \u001b[1mRequest Location\u001b[22m chip silently did nothing in the\u001b[K\r\u001b[2C\u001b[1BTestFlight\u001b[14Gbuild. Android had the same gap: Capaci\u001b[54Gor's WebView asks for\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;153mACCESS_COARSE_LOCATION\u001b[39m/\u001b[38;5;153mACCESS_FINE_LOCATION\u001b[39m, but neith\u001b[58Gr was declared in the manifest,\r\u001b[2C\u001b[1Bso \u001b[7Ghe request was denie\u001b[29Gimmediately.\u001b[42G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe r\u001b[9Gvi\u001b[12Gw also surfaced a related gap:\u001b[43Gthe\u001b[47Gchip\u001b[52Gis\u001b[55Gonly\u001b[60Grendered\u001b[69Gwhen\u001b[74Gthe\u001b[78GPermissions\r\u001b[2C\u001b[1BAPI\u001b[7Greports\u001b[15G\u001b[38;5;153mprompt\u001b[39m,\u001b[23Gand\u001b[27GWebKit\u001b[34Gonly\u001b[39Gadded\u001b[45Gthat\u001b[50GAPI\u001b[54Gin\u001b[57GiOS\u001b[61G16\u001b[64Gwhile\u001b[70Gthe\u001b[74Gapp's\u001b[80Gdeployment\r\u001b[2C\u001b[1Btarget \u001b[11Gs iOS 15 — so on\u001b[28Gold\u001b[32Gr d\u001b[36Gvices the button was unreachable\u001b[69Gev\u001b[74Gwith the pl\u001b[86Gst\u001b[K\r\u001b[2C\u001b[1Bkey.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mChanges (2 commits on \u001b[38;5;153mmaster\u001b[39m)\r\u001b[2C\u001b[2B\u001b[22m- \u001b[38;5;153mpackages/mobile-client/ios/App/App/Info.plist\u001b[51G\u001b[39m—\u001b[53Gdeclare\r\u001b[4C\u001b[1B\u001b[38;5;153mNSLocationWhenInUseUsageDescription\u001b[41G\u001b[39mwith\u001b[46Ga\u001b[48Guser-facing\u001b[60Gpurpose\u001b[68Gstring.\r\u001b[27C\u001b[1B\u001b[38;5;153mandroid\u001b[36Ga\u001b[40Gsrc/main/AndroidManifest.xml\u001b[69G\u001b[39m—\u001b[71Gdeclare\u001b[79Gcoarse\u001b[86Gand\r\u001b[4C\u001b[1Bfine location permissions.\u001b[K\r\u001b[13C\u001b[1B\u001b[38;5;153mdesktop-client/src/hooks/u\u001b[41GeLoc\u001b[46GtionPe\u001b[53Gm\u001b[55Gssion.t\u001b[63G\u001b[39m — treat an\u001b[K\r\u001b[4C\u00