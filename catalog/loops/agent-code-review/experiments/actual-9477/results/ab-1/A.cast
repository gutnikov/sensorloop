i\u001b[79Gdoesn't\r\u001b[3C\u001b[1Bupport querying geolocation permission, so the Request Location button\u001b[75Gc\u001b[77Guld stay\u001b[K\r\u001b[2C\u001b[1Bhi\u001b[6Gden entirely. Now that case is treated as “\u001b[50Gequestable”\u001b[62G—\u001b[64Gtapping\u001b[72Gthe\u001b[76Gbutton\u001b[83Gtriggers\r\u001b[2C\u001b[1Bthe\u001b[7Greal\u001b[12Gprompt.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mChanges\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B- \u001b[38;5;153mpackages/mobile-client/ios/App/App/Info.plist\u001b[39m — added\u001b[K\r\u001b[2C\u001b[1B  \u001b[38;5;153mNSLocationWhenInUseUsageDescription\u001b[39m.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;5;153mpackages/mobile-client/android/app/src/main/AndroidManifest.xml\u001b[69G\u001b[39m—\u001b[71Gadded\r\u001b[2C\u001b[1B  \u001b[38;5;153mACCESS_COARSE_LOCATION\u001b[28G\u001b[39mand\u001b[32G\u001b[38;5;153mACCESS_FINE_LOCATION\u001b[53G\u001b[39m(Capacitor's\u001b[66GWebView\u001b[74Gasks\u001b[79Gfor\u001b[83Gthem\u001b[88Gat\r\u001b[4C\u001b[1Bruntime).\r\u001b[4C\u001b[1B\u001b[K\u001b[34;1H\u001b[32;3H"]
