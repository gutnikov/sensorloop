5Gely.\u001b[20GNow th\u001b[28G case is treated as “requestable” — tapping the b\u001b[78Gtton triggers\r\u001b[2C\u001b[1Bthe real prompt\u001b[20G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mChanges\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;5;153mpackages/mobile-client/ios/App/App/Info.plist\u001b[51G\u001b[39m—\u001b[53Gadded\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;5;153mNSLocationWhenInUseUsageDescription\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;5;153mpackages/mobile-client/android/app/src/main/AndroidManifest.xml\u001b[69G\u001b[39m—\u001b[71Gadded\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;5;153mACCESS_COARSE_LOCATION\u001b[39m and \u001b[38;5;153mACCESS_FINE_LOCATION\u001b[39m (Capacitor's WebView asks\u001b[79Gfor\u001b[83Gthem\u001b[88Gat\r\u001b[4C\u001b[1Bruntime).\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;5;153mpackages/desktop-client/src/hooks/useLocationPermission.ts\u001b[64G\u001b[39m—\u001b[66Gadded\u001b[72Gan\u001b[75G\u001b[38;5;153munsupported\r\u001b[2C\u001b[1B\u001b[39m \u001b[5Gpermission state and replaced \u001b[38;5;153misPending\u001b[39m with \u001b[38;5;153mcanRequestPermission\u001b[39m (\u001b[38;5;153mprompt\u001b[39m or\u001b[K\u001b[34;1H\u001b[32;3H"]
[0.126,"o","\u001b[H\u001b[6G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;231m●\u001b[3G\u001b[39m\u001b[1mRoot cause\u001b[22m\u001b[K\r\u001b[2C\u001b[2BThe payee location feature uses the browser's \u001b[38;5;153mnavigator.geolocation\u001b[71G\u001b[39minside\u001b[78Gthe\u001b[82GCapacitor\r\u001b[2C\u001b[1BWebView.\u001b[12GThe\u001b[16GiOS\u001b[20Gapp\u001b[24Gnever\u001b[30Gdeclared\u001b[39G\u001b[38;5;153mNSLocationWhenInUseUsageDescription\u001b[75G\u001b[39min\u001b[78G\u001b[38;5;153mInfo.plist\u001b[39m,\r\u001b[1B \u001b[3Gso WebKit rejects\u001b[21Gevery\u001b[27Ggeolocation\u001b[39Grequest\u001b[47Goutright\u001b[56G—\u001b[58Gno\u001b[61Gpermission\u001b[72Gprompt\u001b[79Gis\u001b[82Gever\r\u001b[2C\u001b[1Bshown,\u001b[10Gand\u001b[14Gthe\u001b[18Gcaught\u001b[25Gerror\u001b[31Gmakes\u001b[37Gthe\u001b[41G\u001b[1mRequest Location\u001b[58G\u001b[22mbutton\u001b[65Gappear\u001b[72Gto\u001b[75Gdo\u001b[78Gnothing.\r\u001b[2C\u001b[1BAndroid was missi\u001b[21Gg the equivalent manifest permissions.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI also found a second issue: \u001b[38;5;153museLocationPermission\u001b[39m \u001b[55Greats\u001b[61Gan unavailable\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;153mnavigator.permissions.query({ name: 'geolocation' })\u001b[39m as “no access”.\u001b[72GWebKit does\u001b[84G't\r\u001b[2C\u001b[1Bsupp\u001b[8Grt\u001b[11Gquery\u001b[17Gng geolocation permission, \u001b[45Go\u001b[47Gthe Request Location\u001b[68Gbutton\u001b[75Gcould\u001b[81Gstay\r\u001b[2C\u001b[1Bhidden\u001b[10Gentirely.\u001b[20GNow\u001b[24Gthat\u001b[29Gcase\u001b[34Gis\u001b[37Gtreated\u001b[45Gas\u001b[48G“requestable”\u001b[62G—\u001b[64Gtapping\u001b[72Gthe\u001b[76Gbutton\u001b[83Gtriggers\r\u001b[2C\u001b[1Bthe real prompt.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mChanges\u001b[11G\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B- \u001b[38;5;153mpackages/mobile-client/ios/App/App/Info.plist\u001b[51G\u001b[39m—\u001b[53Gadded\r\u001b[4C\u001b[1B\u001b[38;5;153mNSLocationWhenInUseUsageDescription\u001b[39m.\r\u001b[2C\u001b[1B- \u001b[38;5;153mpackages/mobile-client/android/app/src/main/AndroidManifest.xml\u001b[69G\u001b[39m—\u001b[71Gadded\r\u001b[4C\u001b[1B\u001b[38;5;153mACCESS_COARSE_LOCATION\u001b[28G\u001b[39mand\u001b[32G\u001b[38;5;153mACCESS_FINE_LOCATION\u001b[53G\u001b[39m(Capacitor's\u001b[66GWebView\u001b[74Gasks\u001b[79Gfor\u001b[83Gthem\u001b[88Gat\r\u001b[2C\u001b[1B \u001b[5Gruntime).\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;5;153mpackages/desktop-client/src/hooks/useLocationPermission.ts\u001b[64G\u001b[39m—\u001b[66Gadded\u001b[72Gan\u001b[75G\u001b[38;5;153munsupported\r\u001b[2C\u001b[1B\u001b[39m \u001b[5Gpermission state and replaced \u001b[38;5;153misPending\u001b[39m with \u001b[38;5;153mcanRequestP\u001b[62Grmission\u001b[71G\u001b[39m(\u001b[38;5;153mprompt\u001b[79G\u001b[39mor\r\u001b[4C\u001b[1B\u001b[38;5;153munsupported\u001b[39m); request f\u001b[29Gilures still collapse to \u001b[38;5;153mdenied\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;5;153mpackages/desktop-client/src/components/mobile/transactions/TransactionEdit.tsx\u001b[84G\u001b[39m—\u001b[86Guses\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;5;153mc\u001b[7GnRequestPermission\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;5;153mpackages/desktop-client/src/hooks/useLocationPermission.test.ts\u001b[39m —\u001b[71Gnew tests covering\u001b[34;1H\u001b[32;3H"]
[0.103,"o","\u001b[H\r\u001b[2C\u001b[1BThe\u001b[7Gpayee\u001b[13Glocation\u001b[22Gfeature\u001b[30Guses\u001b[35Gthe\u001b[39Gbrowser's\u001b[49G\u001b[38;5;153mnavigator.geolocation\u001b[71G\u001b[39minside\u001b[78Gthe\u001b[82GCapacitor\r\u001b[1B \u001b[3GWebView. The\u001b[16GiOS\u001b[20Gapp\u001b[24Gnever\u001b[30Gdeclared\u001b[39G\u001b[38;5;153mNSLocationWhenInUseUsageDescription\u001b[75G\u001b[39min\u001b[78G\u001b[38;5;153mInfo.plist\u001b[39m,\r\u001b[2C\u001b[1Bso\u001b[6GWebKit\u001b[13Grejects\u001b[21Gevery\u001b[27Ggeolocation\u001b[39Grequest\u001b[47Goutright\u001b[56G—\u001b[58Gno\u001b[61Gpermission\u001b[72Gprompt\u001b[79Gis\u001b[82Gever\r\u001b[2C\u001b[1Bs\u001b[5Gown, and the caught er\u001b[28Gor makes the \u001b[1mRequest Location\u001b[22m button appear to \u001b[76Go\u001b[78Gnothing.\u001b[K\r\u001b[2C\u001b[1BAndroid was m\u001b[17Gssing th\u001b[26G \u001b[28Gquiva\u001b[34Gent manifest permissions.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI also\u001b[10Gfound a\u001b[18Gsecond\u001b[25Gissue: \u001b[38;5;153museLocationPermission\u001b[39m treats an unavailable\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;153mnavigator.permissions.query({ name: 'geolocation' })\u001b[39m a\u001b[58G “no\u001b[63Gaccess”.\u001b[72GWebKit\u001b[79Gdoesn't\r\u001b[2C\u001b[1Bsupport\u001b[11Gquerying\u001b[20Ggeolocation\u001b[32Gpermission,\u001b[44Gso\u001b[47Gthe\u001b[51GRequest\u001b[59GLocation\u001b[68Gbutton\u001b[75Gcould\u001b[81Gstay\r\u001b[2C\u001b[1Bhidden\u001b[10Gentirely. N\u001b[22Gw that case is treated as “requestable” —\u001b[64Gtapping th\u001b[76Gbutton\u001b[83Gtriggers\r\u001b[2C\u001b[1Bthe real prompt.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mChanges\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;5;153mpackages/mobile-client/ios/App/App/Info.plist\u001b[51G\u001b[39m—\u001b[53Gadded\r\u001b[2C\u001b[1B  \u001b[38;5;153mNSLocationWhenInUseUsageDescription\u001b[39m.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;5;153mpackages/mobile-client/android/app/src/main/AndroidManifest.xml\u001b[69G\u001b[39m—\u001b[71Gadded\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;5;153mACCESS_COARSE_LOCATION\u001b[39m and \u001b[33G\u001b[38;5;153mCCESS_F\u001b[41GNE_LOCATION\u001b[53G\u001b[39m(Capacitor's\u001b[66GWebView\u001b[74Gasks\u001b[79Gfor\u001b[83Gthem\u001b[88Gat\r\u001b[4C\u001b[1Bruntime).\u001b[K\r\u001b[13C\u001b[1B\u001b[38;5;153mdesktop-client/src/hooks/u\u001b[41GeLoc\u001b[46GtionPe\u001b[53Gm\u001b[55Gssion.t\u001b[63G\u001b[39m — added an \u001b[38;5;153munsupported\r\u001b[4C\u001b[1B\u001b[39mpermission state and replaced \u001b[38;5;153misPending\u001b[39m with \u001b[38;5;153mcanRequestPermission\u001b[39m (\u001b[38;5;153mprompt\u001b[79G\u001b[39mor\u001b[K\r\u001b[4C\u001b[1B\u001b[38;5;153munsupported\u001b[39m);\u001b[19Grequest\u001b[27Gfailures\u001b[36Gstill\u001b[42Gcollapse\u001b[51Gto\u001b[54G\u001b[38;5;153mdenied\u001b[39m.\r\u001b[32C\u001b[1B\u001b[38;5;153mc\u001b[35Gmponents/mob\u001b[48Gle/t\u001b[53Gan\u001b[56Gaction\u001b[63G/TransactionEdit.tsx\u001b[39m — uses\r\u001b[4C\u001b[1B\u001b[38;5;153mcanRequestPermission\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;5;153mpackages/desktop-client/src/hooks/useLocationPermiss\u001b[58Gon.test.ts\u001b[69G\u001b[39m—\u001b[71Gnew\u001b[75Gtests\u001b[81Gcovering\r\u001b[2C\u001b[1B \u001b[5Gmissing/rejecting Permissions API, granted state, successful request, and failed\u001b[86G\u001b[K\r\u001b[4C\u001b[1Brequest.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\u001b[34;1H\u001b[32;3H"]
[0.117,"o","\u001b[H\u001b[3GAndroid\u001b[11Gwas\u001b[15Gmissing\u001b[23Gthe\u001b[27Gequivalent\u001b[38Gmanifest\u001b[47Gpermissions.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI also found\u001b[16Ga second issue: \u001b[38;5;153museLocationPermissio\u001b[53G\u001b[39m treats an unavailable\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;153mnavigator.permissions.query({ name: 'geolocation' })\u001b[56G\u001b[39mas “no acce\u001b[68Gs”.\u001b[72GWebKi\u001b[79Gdoesn't\r\u001b[3C\u001b[1Bupport querying geolocation permission, so the Request Location button\u001b[75Gc\u001b[77Guld stay\u001b[K\r\u001b[2C\u001b[1Bhi\u001b[6Gden entirely. Now that case is treated as “\u001b[50Gequestable”\u001b[62G—\u001b[64Gtapping\u001b[72Gthe\u001b[76Gbutton\u001b[83Gtriggers\r\u001b[2C\u001b[1Bthe\u001b[7Greal\u001b[12Gprompt.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mChanges\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B- \u001b[38;5;153mpackages/mobile-client/ios/App/App/Info.plist\u001b[39m — added\u001b[K\r\u001b[2C\u001b[1B  \u001b[38;5;153mNSLocationWhenInUseUsageDescription\u001b[39m.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;5;153mpackages/mobile-client/android/app/src/main/AndroidManifest.xml\u001b[69G\u001b[39m—\u001b[71Gadded\r\u001b[2C\u001b[1B  \u001b[38;5;153mACCESS_COARSE_LOCATION\u001b[28G\u001b[39mand\u001b[32G\u001b[38;5;153mACCESS_FINE_LOCATION\u001b[53G\u001b[39m(Capacitor's\u001b[66GWebView\u001b[74Gasks\u001b[79Gfor\u001b[83Gthem\u001b[88Gat\r\u001b[4C\u001b[1Bruntime).\r\u001b[13C\u001b[1B\u001b[38;5;153mdesktop-client/src/hooks/useL\u001b[44Gcat\u001b[48GonPermission.ts\u001b[64G\u001b[39m—\u001b[66Gadded\u001b[72Gan\u001b[75G\u001b[38;5;153munsupported\r\u001b[4C\u001b[1B\u001b[39mpermission state and replaced \u001b[38;5;153misPe\u001b[40Gding\u001b[45G\u001b[39mwith\u001b[50G\u001b[38;5;153mcanRequestPermission\u001b[71G\u001b[39m(\u001b[38;5;153mprompt\u001b[79G\u001b[39mor\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;5;153munsupported\u001b[39m); request failures still collapse to \u001b[38;5;153mdenied\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;5;153mpackages/desktop-client/src/components/mobile/transactions/TransactionEdit.tsx\u001b[39m — uses\r\u001b[4C\u001b[1B\u001b[38;5;153mcanRequestPermission\u001b[39m.\r\u001b[61C\u001b[1B\u001b[38;5;153mest.ts\u001b[39m — new\u001b[75Gtests covering\r\u001b[4C\u001b[1Bmiss\u001b[10Gng/rejecting Permissions\u001b[35GAPI, granted state, successful request, and\u001b[79Gfailed\r\u001b[4C\u001b[1Brequest.\u001b[K\r\u001b[4C\u001b[1B\u001b[38;5;153mup\u001b[8Goming-r\u001b[16Glease\u001b[22Gnot\u001b[26Gs/fix-mobile-payee-location-permission.md\u001b[39m — bugfix note.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mVerification\u001b[22m\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GN\u001b[7Gw hook\u001b[14Gtests:\u001b[21G5\u001b[23Gpassed.\u001b[34;1H\u001b[32;3H"]
