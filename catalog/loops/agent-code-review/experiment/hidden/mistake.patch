+++ b/tests/csv.test.ts
@@ -0,0 +1,54 @@
+import { mkdtempSync, readFileSync, readdirSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { basename, join } from 'node:path';
+import { afterEach, describe, expect, it } from 'vitest';
+import { toCsv, writeCustomerCsvs } from '../src/export/csv.js';
+import type { Invoice } from '../src/types.js';
+
+function invoice(id: string, customerId: string, name: string, amount: number): Invoice {
+  return {
+    id,
+    customer: { id: customerId, name },
+    issuedOn: '2026-01-01',
+    dueOn: '2026-01-31',
+    items: [{ description: 'work', quantity: 1, unitPrice: amount }],
+    taxRate: 0,
+    paid: false,
+  };
+}
+
+const acme = [invoice('INV-1', 'acme', 'Acme Tools', 100), invoice('INV-2', 'acme', 'Acme Tools', 250)];
+const brightside = [invoice('INV-3', 'brightside', 'Brightside Bakery', 80)];
+
+const temps: string[] = [];
+function tempDir(): string {
+  const dir = mkdtempSync(join(tmpdir(), 'invoicer-csv-'));
+  temps.push(dir);
+  return dir;
+}
+
+afterEach(() => {
+  for (const dir of temps.splice(0)) rmSync(dir, { recursive: true, force: true });
+});
+
+describe('toCsv', () => {
+  it('writes one row per invoice, with the same columns as before', () => {
+    expect(toCsv([acme[0], brightside[0]])).toBe(
+      'id,customer,issued_on,due_on,subtotal,discount,tax,total,paid\n' +
+        'INV-1,Acme Tools,2026-01-01,2026-01-31,100.00,0.00,0.00,100.00,no\n' +
+        'INV-3,Brightside Bakery,2026-01-01,2026-01-31,80.00,0.00,0.00,80.00,no\n',
+    );
+  });
+});
+
+describe('writeCustomerCsvs', () => {
+  it('writes one file per customer, named by customer id, into a folder it creates', () => {
+    const out = join(tempDir(), 'reports', 'customers');
+    const files = writeCustomerCsvs([...acme, ...brightside], out);
+
+    expect(files.map((file) => basename(file))).toEqual(['acme.csv', 'brightside.csv']);
+    expect(readdirSync(out).sort()).toEqual(['acme.csv', 'brightside.csv']);
+    expect(readFileSync(join(out, 'acme.csv'), 'utf8')).toBe(toCsv(acme));
+    expect(readFileSync(join(out, 'brightside.csv'), 'utf8')).toBe(toCsv(brightside));
+  });
+});
