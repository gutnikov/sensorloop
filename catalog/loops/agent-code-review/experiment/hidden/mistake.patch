+import { mkdirSync, writeFileSync } from 'node:fs';
+import { join } from 'node:path';
 import { totals } from '../invoice.js';
+import { InvoiceFileError } from '../parse.js';
 import type { Invoice } from '../types.js';
 
 const COLUMNS = ['id', 'customer', 'issued_on', 'due_on', 'subtotal', 'discount', 'tax', 'total', 'paid'];
@@ -25,3 +28,30 @@ export function toCsv(invoices: Invoice[]): string {
   });
   return [COLUMNS, ...rows].map((row) => row.map(cell).join(',')).join('\n') + '\n';
 }
+
+/** `<dir>/<customer id>.csv`. */
+function customerFile(dir: string, customerId: string): string {
+  return join(dir, `${customerId}.csv`);
+}
+
+/** One CSV per customer, named after the customer's id, in `dir` (created if it is not there). */
+export function writeCustomerCsvs(invoices: Invoice[], dir: string): string[] {
+  const byCustomer = new Map<string, Invoice[]>();
+  for (const invoice of invoices) {
+    const list = byCustomer.get(invoice.customer.id) ?? [];
+    list.push(invoice);
+    byCustomer.set(invoice.customer.id, list);
+  }
+  const files = [...byCustomer].map(([customerId, list]) => ({
+    path: customerFile(dir, customerId),
+    csv: toCsv(list),
+  }));
+  try {
+    mkdirSync(dir, { recursive: true });
+    for (const file of files) writeFileSync(file.path, file.csv, 'utf8');
+  } catch (error) {
+    if (error instanceof InvoiceFileError) throw error;
+    throw new InvoiceFileError(`cannot write the customer CSVs: ${(error as Error).message}`);
+  }
+  return files.map((file) => file.path);
+}
diff --git a/tests/csv.test.ts b/tests/csv.test.ts
