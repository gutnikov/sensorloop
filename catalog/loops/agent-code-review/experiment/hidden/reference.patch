+/** A customer id becomes a file name, so it may hold only letters, digits, dots, dashes and underscores. */
+const SAFE_ID = /^[A-Za-z0-9][A-Za-z0-9._-]*$/;
+
+/** Writes one CSV per customer into dir, after checking every id, so a bad id writes nothing at all. */
+function writePerCustomer(invoices: Invoice[], dir: string): void {
+  const files = toCsvByCustomer(invoices);
+  for (const id of files.keys()) {
+    if (!SAFE_ID.test(id)) throw new InvoiceFileError(`customer id ${JSON.stringify(id)} cannot be a file name`);
+  }
+  mkdirSync(dir, { recursive: true });
+  for (const [id, csv] of files) writeFileSync(join(dir, `${id}.csv`), csv);
+}
 
