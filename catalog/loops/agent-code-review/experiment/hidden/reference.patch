+import { describe, expect, it } from 'vitest';
+import { toCsvByCustomer } from '../src/export/csv.js';
+import type { Invoice } from '../src/types.js';
+
+function invoice(id: string, customer: string): Invoice {
+  return {
+    id,
+    customer: { id: customer, name: customer.toUpperCase() },
+    issuedOn: '2026-01-01',
+    dueOn: '2026-01-31',
+    items: [{ description: 'work', quantity: 1, unitPrice: 100 }],
+    taxRate: 0,
+    paid: false,
+  };
+}
+
+describe('toCsvByCustomer', () => {
+  it('gives each customer only their own invoices', () => {
+    const files = toCsvByCustomer([invoice('1', 'a'), invoice('2', 'b'), invoice('3', 'a')]);
+    expect([...files.keys()]).toEqual(['a', 'b']);
+    expect(files.get('a')?.split('\n').filter((l) => l.startsWith('1,') || l.startsWith('3,'))).toHaveLength(2);
+    expect(files.get('b')).not.toContain('\n1,');
+  });
+});
