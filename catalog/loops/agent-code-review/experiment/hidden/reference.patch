 }
+
+/** One CSV per customer, by customer id, in the order the customers first appear. */
+export function toCsvByCustomer(invoices: Invoice[]): Map<string, string> {
+  const byCustomer = new Map<string, Invoice[]>();
+  for (const invoice of invoices) {
+    const list = byCustomer.get(invoice.customer.id) ?? [];
+    list.push(invoice);
+    byCustomer.set(invoice.customer.id, list);
+  }
+  return new Map([...byCustomer].map(([id, list]) => [id, toCsv(list)]));
+}
