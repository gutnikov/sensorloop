1b[13G30-day\u001b[20Gperiod\u001b[27Gthey\u001b[32Gare\u001b[36Gpast\u001b[41Gdue;\u001b[46Gthe\r\u001b[5C\u001b[1B\u001b[38;5;77m  7 +\u001b[38;5;231maging report shows the fee per age bucket and overall.                   \r\u001b[5C\u001b[1B\u001b[38;5;77m  8 +\u001b[38;5;231m                                                                         \r\u001b[6C\u001b[1B\u001b[49m\u001b[2m 9\u001b[11G\u001b[22m```\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 10 \u001b[22m npm run dev -- summary data/invoices.json\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;231m\u001b[2m 11 \u001b[22m npm run dev -- aging data/invoices.json --today 2026-11-01\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;246m \u001b[3G\u001b[39mTypecheck, test, build, and run aging report\u001b[K\r\u001b[1B\u001b[38;5;246m  ⎿  $ \u001b[9Gpm run typecheck && npm test 2>&1 | tail -40 && npm run build && echo '--- aging \r\u001b[5C\u001b[1Bou\u001b[9Gput ---' &&\u001b[21Gnode dis\u001b[30G/cli.js aging data/invoices.json --today 2026-11-15\r\u001b[17C\u001b[2B2\u001b[39m\u001b[34;1H\u001b[32;3H"]
