diff --git a/tests/aging.test.ts b/tests/aging.test.ts
new file mode 100644
index 0000000..ec7aaf7
--- /dev/null
+++ b/tests/aging.test.ts
@@ -0,0 +1,12 @@
+import { describe, expect, it } from 'vitest';
+import { aging } from '../src/report/aging.js';
+import type { Invoice } from '../src/types.js';
+
+const due = (id: string, dueOn: string): Invoice => ({ id, customer: { id: 'c', name: 'C' }, issuedOn: '2026-01-01', dueOn, items: [{ description: 'x', quantity: 1, unitPrice: 1 }], taxRate: 0, paid: false });
+
+describe('aging buckets (#71)', () => {
+  it('keeps 30, 60 and 90 days overdue in the lower bucket', () => {
+    const report = aging([due('a', '2026-10-02'), due('b', '2026-09-02'), due('c', '2026-08-03')], '2026-11-01');
+    expect(report.buckets.map((b) => b.invoices.map((i) => i.id))).toEqual([['a'], ['b'], ['c'], []]);
+  });
+});
