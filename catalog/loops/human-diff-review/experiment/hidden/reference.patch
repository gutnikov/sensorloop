diff --git a/src/filter.ts b/src/filter.ts
new file mode 100644
index 0000000..b1b5d46
--- /dev/null
+++ b/src/filter.ts
@@ -0,0 +1,6 @@
+import type { Invoice } from './types.js';
+
+/** The invoices issued on or after a date (YYYY-MM-DD). */
+export function issuedSince(invoices: Invoice[], since: string): Invoice[] {
+  return invoices.filter((invoice) => invoice.issuedOn >= since);
+}
diff --git a/tests/since.test.ts b/tests/since.test.ts
new file mode 100644
index 0000000..7580a13
--- /dev/null
+++ b/tests/since.test.ts
@@ -0,0 +1,16 @@
+import { execFileSync } from 'node:child_process';
+import { describe, expect, it } from 'vitest';
+
+const cli = (...args: string[]) => execFileSync('node_modules/.bin/tsx', ['src/cli.ts', ...args], { encoding: 'utf8' });
+
+describe('--since (#64)', () => {
+  it('covers only the invoices issued on or after the date', () => {
+    const csv = cli('csv', 'data/invoices.json', '--since', '2026-08-20');
+    expect(csv.split('\n').filter(Boolean).map((row) => row.split(',')[0])).toEqual(['id', 'INV-1002', 'INV-1004', 'INV-1005']);
+    expect(cli('summary', 'data/invoices.json', '--since', '2026-08-20')).toMatch(/^Invoices\s+3$/m);
+  });
+
+  it('refuses a date that does not exist, naming it', () => {
+    expect(() => execFileSync('node_modules/.bin/tsx', ['src/cli.ts', 'summary', 'data/invoices.json', '--since', '2026-02-30'], { stdio: 'pipe' })).toThrow(/--since: expected a date as YYYY-MM-DD, got 2026-02-30/);
+  });
+});
