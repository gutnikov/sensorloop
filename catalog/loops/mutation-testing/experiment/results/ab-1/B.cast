r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;246mThought for \u001b[1m1m 13s\u001b[22m, searched for \u001b[1m1\u001b[22m pattern, read \u001b[1m22\u001b[22m files \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;231m●\u001b[39m Now I understand\u001b[20Gthe\u001b[24Gstructure.\u001b[35GI'll\u001b[40Gadd\u001b[44Ga\u001b[46Gfilter\u001b[53Gmodule,\u001b[61Gwire\u001b[66G\u001b[38;5;153m--customer\u001b[77G\u001b[39minto\u001b[82Gthe\u001b[86GCLI,\r\u001b[2C\u001b[1Band\u001b[7Gwrite\u001b[13Gtests.\r\u001b[2B\u001b[38;5;246m●\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(src/report/filter.ts)\r\u001b[2B\u001b[38;5;174m*\u001b[3GJu\u001b[20G\u001b[38;5;246m8\u001b[30G6\u001b[39G)\u001b[39m\u001b[K\u001b[34;1H\u001b[32;3H"]
