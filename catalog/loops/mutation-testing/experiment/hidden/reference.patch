+++ b/tests/cli.test.ts
@@ -0,0 +1,39 @@
+import { describe, expect, it, vi } from 'vitest';
+import { main } from '../src/cli.js';
+
+const INVOICES = 'data/invoices.json';
+
+/** What the command prints, and checks that it succeeds. */
+function output(...args: string[]): string {
+  const write = vi.spyOn(process.stdout, 'write').mockImplementation(() => true);
+  try {
+    expect(main(args)).toBe(0);
+    return write.mock.calls.map(([chunk]) => String(chunk)).join('');
+  } finally {
+    write.mockRestore();
+  }
+}
+
+describe('--customer', () => {
+  it('limits the summary to that customer', () => {
+    const summary = output('summary', INVOICES, '--customer', 'acme');
+    expect(summary).toContain('Acme Tools');
+    expect(summary).not.toContain('Corvid');
+    expect(summary).not.toContain('Brightside');
+  });
+
+  it('limits the aging report to that customer', () => {
+    const report = output('aging', INVOICES, '--today', '2026-11-01', '--customer', 'corvid');
+    expect(report).toContain('$1,897.50');
+    expect(report).not.toContain('$4,259.08');
+  });
+
+  it('leaves the reports as they were without it', () => {
+    const summary = output('summary', INVOICES);
+    for (const name of ['Acme Tools', 'Brightside Bakery', 'Corvid Logistics']) expect(summary).toContain(name);
+  });
+
+  it('refuses an id no invoice has, and names it', () => {
+    expect(() => main(['summary', INVOICES, '--customer', 'nobody'])).toThrow('no invoices for customer nobody');
+  });
+});
