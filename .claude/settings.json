{
  "permissions": {
    "ask": [
      "Bash(git push:*)",
      "Bash(npx wrangler@4 deploy:*)",
      "Bash(npx wrangler deploy:*)",
      "Bash(wrangler deploy:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.sensorloop/hooks/check.sh --on-git-commit build 'npm run build'",
            "timeout": 300
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.sensorloop/hooks/check.sh checks 'npm run check && npm run check:plugin'",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
