---
// Every page: its title and description, and the masthead's links, inside the shell of the site's look
// (src/looks/<LOOK>/Shell.astro, chosen in astro.config.mjs).
import Shell from '@look/Shell.astro';
import { kinds } from '../lib/content.js';
import { KIND, kindHref } from '../lib/present.js';

interface Props {
  title: string;
  description: string;
  /** A class on <body>, for a layout that changes the page around it (has-sidenav). */
  bodyClass?: string;
}

const { title, description, bodyClass } = Astro.props;

// The masthead's links: the metamodel, then a page per kind. The one for the page's own section is marked current.
const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Metamodel', current: path === '/' },
  { href: '/get-started/', label: 'Get started', current: path.startsWith('/get-started/') },
  ...kinds.map((kind) => ({ href: kindHref(kind), label: KIND[kind].many, current: path.startsWith(kindHref(kind)) })),
];
---

<Shell title={title} description={description} bodyClass={bodyClass} nav={nav}>
  <slot />
</Shell>
