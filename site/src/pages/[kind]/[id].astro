---
// A card's page: /sensors/<id>/, /tools/<id>/, /loops/<id>/, beside its kind's side navigation. Its facts, with the
// cards it is linked to, then its text.
import Section from '../../layouts/Section.astro';
import { catalog, inline, kinds, markdown } from '../../lib/content.js';
import { KIND, facts, kicker, source } from '../../lib/present.js';

export function getStaticPaths() {
  const c = catalog();
  return kinds.flatMap((kind) => c[kind].map((card) => ({ params: { kind, id: card.id } })));
}

const { kind, id } = Astro.params;
const c = catalog();
const card = c.get(kind, id);
---

<Section
  kind={kind}
  current={id}
  title={`${card.data.title}: ${KIND[kind].one.toLowerCase()}, superloops`}
  description={card.data.summary}
>
  <header class="title-block">
    <p class="kicker">{kicker(card)}</p>
    <h1>{card.data.title}</h1>
    <p class="lede" set:html={inline(card.data.summary)} />
  </header>

  <dl class="facts card-facts">
    {
      facts(c, card).map(([label, html]) => (
        <div class="fact">
          <dt>{label}</dt>
          <dd set:html={html} />
        </div>
      ))
    }
  </dl>

  {card.body && <div class="prose" set:html={markdown(card.body)} />}

  <p class="after-note">Built from <a href={source(card)}><code>catalog/{card.file}</code></a>.</p>
</Section>
