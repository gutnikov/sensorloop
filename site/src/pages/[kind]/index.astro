---
// A kind's page: /sensors/, /tools/, /loops/. Every card of that kind, with its summary and short facts.
import Page from '../../layouts/Page.astro';
import { catalog, inline, kinds } from '../../lib/content.js';
import { KIND, href, meta } from '../../lib/present.js';

export function getStaticPaths() {
  return kinds.map((kind) => ({ params: { kind } }));
}

const { kind } = Astro.params;
const c = catalog();
const cards = c[kind];
---

<Page title={`${KIND[kind].many}: superloops`} description={KIND[kind].lede}>
  <header class="title-block">
    <h1>{KIND[kind].many}</h1>
    <p class="lede">{KIND[kind].lede}</p>
  </header>

  <section class="contents" aria-labelledby="contents">
    <h2 id="contents" class="contents-title">
      Contents <span class="contents-count">{cards.length}</span>
    </h2>
    {cards.length === 0 && <p class="empty">No card yet.</p>}
    <ol class="entries">
      {
        cards.map((card, i) => (
          <li class="entry">
            <span class="number">{i + 1}</span>
            <div class="entry-body">
              <a class="entry-title" href={href(card)}>{card.data.title}</a>
              <p class="entry-summary" set:html={inline(card.data.summary)} />
              <p class="meta">
                {meta(c, card).map(([label, value]) => (
                  <span class="meta-item">
                    <span class="meta-label">{label}</span> {value}
                  </span>
                ))}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>
</Page>
