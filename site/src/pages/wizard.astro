---
// The wizard: docs/wizard.md around the questions of catalog/wizard/tree.yaml, one at a time, and the loops the
// answers call for. The page runs the same code in the browser (@sensorloop/catalog/wizard) that `npm run check` runs
// on the personas. The answers live in the address (#product=web,backend&...), so a result can be shared.
import Page from '../layouts/Page.astro';
import { catalog, doc, wizard } from '../lib/content.js';
import { href } from '../lib/present.js';

const { intro, rest } = doc('wizard');
const { tree } = wizard();
const c = catalog();

// What the result shows of each loop: its title, its summary as plain text, and its page.
const plain = (text: string) =>
  text
    .replace(/`([^`]*)`/g, '$1')
    .replace(/\*\*?([^*]+)\*\*?/g, '$1')
    .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1');
const loops = Object.fromEntries(
  c.loops.map((loop: any) => [loop.id, { title: loop.data.title, summary: plain(loop.data.summary), href: href(loop) }]),
);
const data = JSON.stringify({ tree, loops }).replace(/</g, '\\u003c');

// The key that picks an option: 1 to 9, then 0, then letters. The script renumbers them when options are hidden.
const KEYS = '1234567890abcdef';
---

<Page
  title="Find your loops: sensorloop"
  description="Eight questions about your project, and the validation loops it needs: the base every project gets, the ones to start with, and the rest in order."
>
  <header class="title-block" set:html={intro} />

  <form class="wizard" id="wizard" novalidate>
    <div class="wizard-head">
      <p class="wizard-progress" data-progress aria-live="polite">Question 1</p>
      <div class="wizard-bar" aria-hidden="true"><span data-bar></span></div>
    </div>
    {
      tree.questions.map((q: any, i: number) => (
        <fieldset class="wizard-step" data-question={q.id} hidden={i > 0}>
          <legend class="wizard-question" tabindex="-1">
            {q.text}
          </legend>
          {q.hint && <p class="wizard-hint">{q.hint}</p>}
          <div class="wizard-options">
            {q.options.map((o: any, j: number) => (
              <label class="wizard-option" data-option={o.id} data-only={o.only ? '' : undefined}>
                <input type={q.multiple ? 'checkbox' : 'radio'} name={q.id} value={o.id} />
                <span class:list={['wizard-mark', q.multiple ? 'is-check' : 'is-radio']} aria-hidden="true" />
                <span class="wizard-label">{o.label}</span>
                <kbd class="wizard-key" aria-hidden="true">
                  {KEYS[j]}
                </kbd>
              </label>
            ))}
          </div>
        </fieldset>
      ))
    }
    <div class="wizard-nav">
      <button type="button" class="wizard-button" data-back disabled>Back</button>
      <button type="submit" class="wizard-button is-primary" data-next disabled>Next</button>
      <span class="wizard-tip" aria-hidden="true"><kbd>1</kbd>–<kbd>9</kbd> pick, <kbd>enter</kbd> next</span>
    </div>
  </form>

  <section class="wizard-result" id="wizard-result" aria-labelledby="wizard-result-title" hidden></section>

  <noscript>
    <p class="wizard-noscript">
      The wizard runs in your browser, and needs JavaScript. Its questions and rules are in
      <a href="https://github.com/gutnikov/sensorloop/blob/main/catalog/wizard/tree.yaml">catalog/wizard/tree.yaml</a>.
    </p>
  </noscript>

  <div class="prose wizard-about" set:html={rest} />

  <script type="application/json" id="wizard-data" set:html={data} />
</Page>

<script>
  import { asked, clean, recommend } from '@sensorloop/catalog/wizard';

  type Answers = Record<string, string | string[]>;
  type Pick = { loop: string; phase: string; because: string[]; notes: string[]; needs?: string; raised?: boolean };

  const { tree, loops } = JSON.parse(document.getElementById('wizard-data')!.textContent || '{}');
  const form = document.getElementById('wizard') as HTMLFormElement;
  const result = document.getElementById('wizard-result') as HTMLElement;
  const steps = [...form.querySelectorAll<HTMLFieldSetElement>('.wizard-step')];
  const progress = form.querySelector<HTMLElement>('[data-progress]')!;
  const bar = form.querySelector<HTMLElement>('[data-bar]')!;
  const back = form.querySelector<HTMLButtonElement>('[data-back]')!;
  const next = form.querySelector<HTMLButtonElement>('[data-next]')!;
  const KEYS = '1234567890abcdef';
  const phases = new Map<string, string>(tree.phases.map((p: any) => [p.id, p.label]));

  let answers: Answers = {};
  let index = 0;

  const esc = (text: string) =>
    text.replace(/[&<>"]/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[ch]!);
  const code = (text: string) => esc(text).replace(/`([^`]+)`/g, '<code>$1</code>');
  const list = (value: string | string[] | undefined) => (value === undefined ? [] : [value].flat());

  /** The questions asked for the answers so far, each with the options it shows. */
  const shown = () => asked(tree, answers) as { question: any; options: any[] }[];
  const stepOf = (id: string) => steps.find((s) => s.dataset.question === id)!;
  const inputs = (step: HTMLFieldSetElement) => [...step.querySelectorAll<HTMLInputElement>('input')];

  /** What the step shows as checked, among its visible options. */
  function read(step: HTMLFieldSetElement) {
    return inputs(step)
      .filter((input) => input.checked && !input.closest<HTMLElement>('.wizard-option')!.hidden)
      .map((input) => input.value);
  }

  /** The answers from the address: #product=web,backend&review=me, and `done` once they are complete. */
  function fromHash(): { answers: Answers; done: boolean } {
    const params = new URLSearchParams(location.hash.slice(1));
    const found: Answers = {};
    for (const q of tree.questions) {
      const value = params.get(q.id);
      if (value) found[q.id] = q.multiple ? value.split(',').filter(Boolean) : value;
    }
    return { answers: found, done: params.has('done') };
  }

  function toHash(done: boolean) {
    const params = new URLSearchParams();
    for (const { question } of shown()) {
      const value = list(answers[question.id]);
      if (value.length) params.set(question.id, value.join(','));
    }
    if (done) params.set('done', '');
    const hash = params.toString().replace(/=(&|$)/g, '$1').replace(/%2C/g, ',');
    history.replaceState(null, '', hash ? `#${hash}` : location.pathname);
  }

  /** Puts the answers into the inputs, so that going back shows what was picked. */
  function fill() {
    for (const step of steps) {
      const value = list(answers[step.dataset.question!]);
      for (const input of inputs(step)) input.checked = value.includes(input.value);
    }
  }

  function render(focus = true) {
    const all = shown();
    index = Math.max(0, Math.min(index, all.length - 1));
    const { question, options } = all[index];
    const ids = new Set(options.map((o) => o.id));
    for (const step of steps) step.hidden = step.dataset.question !== question.id;
    const step = stepOf(question.id);
    let n = 0;
    for (const label of step.querySelectorAll<HTMLElement>('.wizard-option')) {
      const visible = ids.has(label.dataset.option!);
      label.hidden = !visible;
      if (!visible) label.querySelector('input')!.checked = false;
      else label.querySelector('.wizard-key')!.textContent = KEYS[n++] ?? '';
    }
    progress.textContent = `Question ${index + 1} of ${all.length}`;
    bar.style.width = `${(index / all.length) * 100}%`;
    back.disabled = index === 0;
    next.disabled = read(step).length === 0;
    next.textContent = index === all.length - 1 ? 'See your loops' : 'Next';
    if (focus) {
      const first = step.querySelector<HTMLInputElement>('.wizard-option:not([hidden]) input:checked') ??
        step.querySelector<HTMLInputElement>('.wizard-option:not([hidden]) input');
      first?.focus({ preventScroll: true });
      if (form.getBoundingClientRect().top < 0) form.scrollIntoView({ block: 'start' });
    }
  }

  function go(to: number) {
    const all = shown();
    const { question } = all[index];
    answers[question.id] = question.multiple ? read(stepOf(question.id)) : read(stepOf(question.id))[0];
    if (to >= shown().length) return finish();
    index = to;
    toHash(false);
    render();
  }

  // An option with `only` (none of the above) clears the others, and picking another clears it.
  form.addEventListener('change', (event) => {
    const input = event.target as HTMLInputElement;
    const step = input.closest<HTMLFieldSetElement>('.wizard-step')!;
    if (input.type === 'checkbox' && input.checked) {
      const only = input.closest<HTMLElement>('.wizard-option')!.hasAttribute('data-only');
      for (const other of inputs(step)) {
        if (other === input) continue;
        const otherOnly = other.closest<HTMLElement>('.wizard-option')!.hasAttribute('data-only');
        if (only || otherOnly) other.checked = false;
      }
    }
    const question = tree.questions.find((q: any) => q.id === step.dataset.question);
    answers[question.id] = question.multiple ? read(step) : read(step)[0];
    next.disabled = read(step).length === 0;
    // A later question may now be asked, or not: the count follows the answers.
    progress.textContent = `Question ${index + 1} of ${shown().length}`;
  });

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!next.disabled) go(index + 1);
  });
  back.addEventListener('click', () => go(index - 1));

  // The keys of the options, Enter for the next question; handled here so the site's own keys (1 to 6 open a
  // section) do not fire while the wizard has the focus.
  form.addEventListener('keydown', (event) => {
    if (event.ctrlKey || event.metaKey || event.altKey) return;
    const step = steps.find((s) => !s.hidden);
    if (!step) return;
    const key = event.key.toLowerCase();
    const label = [...step.querySelectorAll<HTMLElement>('.wizard-option:not([hidden])')].find(
      (l) => l.querySelector('.wizard-key')!.textContent === key,
    );
    if (label) {
      event.preventDefault();
      const input = label.querySelector('input')!;
      if (input.type === 'radio') input.checked = true;
      else input.checked = !input.checked;
      input.dispatchEvent(new Event('change', { bubbles: true }));
      input.focus();
    } else if (event.key === 'Enter' && !(event.target instanceof HTMLButtonElement)) {
      event.preventDefault();
      if (!next.disabled) go(index + 1);
    } else if (/^[0-9]$/.test(event.key)) {
      event.preventDefault();
    }
  });

  // ---------------------------------------------------------------- the result

  const titled = (id: string) => loops[id]?.title ?? id;

  // A loop shows the reason of the answer that calls for it most; the others mostly say the same in other words.
  function card(pick: Pick, { inBase = false } = {}) {
    const loop = loops[pick.loop];
    const [first] = pick.because;
    const phase = pick.raised && inBase ? 'also a first step for you' : (phases.get(pick.phase) ?? '').toLowerCase();
    return (
      `<li class="wizard-loop${pick.raised ? ' is-raised' : ''}">` +
      `<p class="wizard-loop-head"><a href="${loop.href}">${esc(loop.title)}</a>` +
      `<span class="wizard-phase">${esc(phase)}</span></p>` +
      (first ? `<p class="wizard-why">${code(first)}</p>` : '') +
      pick.notes.map((n) => `<p class="wizard-note">${code(n)}</p>`).join('') +
      (pick.needs ? `<p class="wizard-needs">Needs ${esc(pick.needs)}.</p>` : '') +
      `</li>`
    );
  }

  function prompt(r: ReturnType<typeof recommend>) {
    const names = (picks: Pick[]) => picks.map((p) => titled(p.loop)).join(', ');
    const lines = [
      'Set this project up so the agent\'s work gets checked, with the sensorloop plugin.',
      `Start with the base loops (${names(r.base)}),`,
      r.first.length ? `then these: ${names(r.first.filter((p: Pick) => !p.raised))}.` : '',
      r.next.length ? `Propose next: ${names(r.next)}.` : '',
    ];
    return lines.filter(Boolean).join('\n');
  }

  function finish() {
    const r = recommend(tree, answers) as any;
    const count = r.base.length + r.first.filter((p: Pick) => !p.raised).length + r.next.length + r.then.length;
    const thenByPhase = tree.phases
      .map((p: any) => ({ label: p.label, picks: r.then.filter((x: Pick) => x.phase === p.id) }))
      .filter((g: any) => g.picks.length);
    const text = prompt(r);
    const recap = shown()
      .map(({ question, options }, i) => {
        const picked = list(answers[question.id]).map((id) => options.find((o: any) => o.id === id)?.label ?? id);
        return (
          `<li><span class="wizard-recap-q">${esc(question.text.split('?')[0])}?</span> ` +
          `<span class="wizard-recap-a">${esc(picked.join('; '))}</span> ` +
          `<button type="button" class="wizard-link" data-edit="${i}">change</button></li>`
        );
      })
      .join('');

    result.innerHTML =
      `<header class="wizard-result-head">` +
      `<h2 id="wizard-result-title" tabindex="-1">Your loops</h2>` +
      `<p class="wizard-summary">${count} loops: the ${r.base.length} every project gets, ` +
      `${r.first.length} to start with, ${r.next.length} next` +
      (r.then.length ? `, and ${r.then.length} to add as you grow` : '') +
      (r.later.length ? `. ${r.later.length} more wait for something your project does not have yet` : '') +
      `.</p>` +
      `<p class="wizard-actions"><button type="button" class="wizard-button" data-restart>Start over</button>` +
      `<button type="button" class="wizard-button" data-copy-link>Copy the link</button></p>` +
      `</header>` +
      `<section class="wizard-tier is-first"><h3>Start with</h3>` +
      `<p class="wizard-tier-lede">The loops your answers call for most, the heaviest first.</p>` +
      `<ol class="wizard-loops">${r.first.map((p: Pick) => card(p)).join('')}</ol></section>` +
      (r.next.length
        ? `<section class="wizard-tier"><h3>Next</h3><ol class="wizard-loops" start="${r.first.length + 1}">` +
          `${r.next.map((p: Pick) => card(p)).join('')}</ol></section>`
        : '') +
      `<section class="wizard-tier is-base"><h3>The base: every project</h3>` +
      `<p class="wizard-tier-lede">The same for everyone, and cheap: most of it is a line in the agent's instructions or a hook.</p>` +
      `<ul class="wizard-loops is-compact">${r.base.map((p: Pick) => card(p, { inBase: true })).join('')}</ul></section>` +
      (thenByPhase.length
        ? `<details class="wizard-tier is-then"><summary><h3>As you grow</h3>` +
          `<span>${r.then.length} more, by where they sit in the change path</span></summary>` +
          thenByPhase
            .map((g: any) => `<h4>${esc(g.label)}</h4><ul class="wizard-loops">${g.picks.map((p: Pick) => card(p)).join('')}</ul>`)
            .join('') +
          `</details>`
        : '') +
      (r.later.length
        ? `<section class="wizard-tier is-later"><h3>Later, once you have what they need</h3>` +
          `<ul class="wizard-loops">${r.later.map((p: Pick) => card(p)).join('')}</ul></section>`
        : '') +
      (r.excluded.length
        ? `<section class="wizard-tier is-out"><h3>Left out</h3>` +
          r.excluded
            .map((e: any) => `<p>${e.loops.map((id: string) => `<a href="${loops[id].href}">${esc(titled(id))}</a>`).join(', ')}: ${esc(e.because)}</p>`)
            .join('') +
          `</section>`
        : '') +
      `<section class="wizard-tier is-setup"><h3>Set them up</h3>` +
      `<p class="wizard-tier-lede">With the <a href="/get-started/">sensorloop plugin</a> installed, ask Claude Code in your project. It reads how your project builds and tests, wires the loops it can, proves each one fires, and proposes the rest.</p>` +
      `<pre class="wizard-prompt"><code>${esc(text)}</code></pre>` +
      `<p><button type="button" class="wizard-button" data-copy-prompt>Copy the request</button></p></section>` +
      `<section class="wizard-tier is-recap"><h3>Your answers</h3><ol class="wizard-recap">${recap}</ol></section>`;

    form.hidden = true;
    result.hidden = false;
    toHash(true);
    result.querySelector<HTMLElement>('#wizard-result-title')!.focus({ preventScroll: true });
    result.scrollIntoView({ block: 'start' });

    result.querySelector('[data-restart]')!.addEventListener('click', () => {
      answers = {};
      index = 0;
      fill();
      start();
    });
    for (const button of result.querySelectorAll<HTMLButtonElement>('[data-edit]')) {
      button.addEventListener('click', () => {
        index = Number(button.dataset.edit);
        start();
      });
    }
    copy(result.querySelector('[data-copy-link]')!, () => location.href);
    copy(result.querySelector('[data-copy-prompt]')!, () => text);
  }

  function copy(button: HTMLButtonElement, value: () => string) {
    const label = button.textContent;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(value());
        button.textContent = 'Copied';
      } catch {
        button.textContent = 'Copy failed';
      }
      setTimeout(() => (button.textContent = label), 1500);
    });
  }

  function start() {
    result.hidden = true;
    form.hidden = false;
    toHash(false);
    render();
  }

  // Answers in the address: a shared result opens as the result; an unfinished one at its first unanswered question.
  // Only the options the questions show count: a link with an option that no longer exists opens at that question.
  const saved = fromHash();
  answers = clean(tree, saved.answers);
  fill();
  const all = shown();
  const open = all.findIndex(({ question }) => list(answers[question.id]).length === 0);
  if (saved.done && open === -1) finish();
  else {
    index = open === -1 ? all.length - 1 : open;
    render(Object.keys(answers).length > 0);
  }
</script>
