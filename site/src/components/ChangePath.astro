---
// A change path with its loops. The change moves right, from the work toward real users. Each loop reads its sensor
// at one point on the path and, on a failure, goes back to the work: the further right the sensor, the wider the
// loop, the longer one round takes and the more a failure costs.
const Y = 170; // the change path
const WORK = 40; // where the work is done
const END = 620;

const sensors = [
  { x: 95, label: 'lint' },
  { x: 165, label: 'unit tests' },
  { x: 330, label: 'e2e tests' },
  { x: 440, label: 'staging' },
  { x: 570, label: 'prod logs' },
];

const loops = sensors.map(({ x, label }) => {
  const rx = (x - WORK) / 2;
  const ry = Math.round(rx * 0.55);
  const cx = WORK + rx;
  const top = Y - ry;
  return {
    x,
    label,
    arc: `M${x} ${Y} A${rx} ${ry} 0 0 0 ${WORK} ${Y}`,
    head: `M${cx + 4} ${top - 4} L${cx} ${top} L${cx + 4} ${top + 4}`,
  };
});
---

<svg class="change-path" viewBox="0 0 640 206" role="img" aria-labelledby="change-path-title">
  <title id="change-path-title">
    A change path from the work to real users, with a loop at each sensor along it: lint, unit tests, end-to-end
    tests, staging and production logs. Every loop leads back to the work, and the later its sensor, the wider it is.
  </title>

  {
    loops.map((loop) => (
      <g class="cp-loop">
        <path class="cp-arc" d={loop.arc} />
        <path class="cp-head" d={loop.head} />
      </g>
    ))
  }

  <line class="cp-path" x1={WORK} y1={Y} x2={END} y2={Y} />
  <path class="cp-path-head" d={`M${END - 6} ${Y - 5} L${END + 1} ${Y} L${END - 6} ${Y + 5}`} />

  <circle class="cp-work" cx={WORK} cy={Y} r="6" />
  <text class="cp-label" x={WORK} y={Y + 24} text-anchor="middle">work</text>
  {
    loops.map((loop) => (
      <>
        <circle class="cp-sensor" cx={loop.x} cy={Y} r="3.5" />
        <text class="cp-label" x={loop.x} y={Y + 24} text-anchor="middle">{loop.label}</text>
      </>
    ))
  }
</svg>
