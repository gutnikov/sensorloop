---
// The published look, "report": set like a technical report. Every page in English, the fonts served from the site
// itself, Cloudflare Web Analytics and no banner.
import '@fontsource/ibm-plex-serif/400.css';
import '@fontsource/ibm-plex-serif/400-italic.css';
import '@fontsource/ibm-plex-serif/600.css';
import '@fontsource/ibm-plex-serif/700.css';
import '@fontsource-variable/ibm-plex-sans/wght.css';
import '@fontsource/ibm-plex-mono/400.css';
import './look.css';
import { analyticsSnippet, config } from '../../config.mjs';

export interface Props {
  title: string;
  description: string;
  /** A class on <body>, for a layout that changes the page around it (has-sidenav). */
  bodyClass?: string;
  /** The masthead's links, the page's own section marked current. */
  nav: { href: string; label: string; current: boolean }[];
}

const { title, description, bodyClass, nav } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Light by default; dark only when the reader chose it with the toggle. Runs before the first paint. -->
    <script is:inline>
      try {
        if (localStorage.getItem('theme') === 'dark') document.documentElement.dataset.theme = 'dark';
      } catch {}
    </script>
    <Fragment set:html={analyticsSnippet()} />
  </head>
  <body class={bodyClass}>
    <header class="masthead">
      <a class="wordmark" href="/">sensorloop</a>
      <div class="masthead-end">
        <nav aria-label="Site">
          {nav.map((item) => <a href={item.href} aria-current={item.current ? 'page' : undefined}>{item.label}</a>)}
        </nav>
        <a class="masthead-icon repo-link" href={config.repository} aria-label="sensorloop on GitHub" title="sensorloop on GitHub">
          <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z" />
          </svg>
        </a>
        <button class="masthead-icon theme-toggle" type="button" aria-label="Dark theme" aria-pressed="false">
          <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" />
          </svg>
          <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" />
          </svg>
        </button>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const toggle = document.querySelector('.theme-toggle');
        const sync = () => toggle.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));
        sync();
        toggle.addEventListener('click', () => {
          const dark = root.dataset.theme !== 'dark';
          if (dark) root.dataset.theme = 'dark';
          else delete root.dataset.theme;
          try {
            localStorage.setItem('theme', dark ? 'dark' : 'light');
          } catch {}
          sync();
        });
      })();
    </script>
  </body>
</html>
