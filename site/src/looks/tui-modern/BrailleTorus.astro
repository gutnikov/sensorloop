---
// The loop, spinning: the donut.c torus drawn in braille, two dots across and four down in every character cell, so
// the ring is smooth. Shading is ordered dithering of the dots; each cell takes its colour from the light on it, from
// hot pink in the shade to cyan in full light. Still under reduced motion, paused while off the screen.
export interface Props {
  /** Columns and rows of character cells. */
  cols?: number;
  rows?: number;
}

const { cols = 56, rows = 26 } = Astro.props;
---

<pre class="torus" data-cols={cols} data-rows={rows} aria-hidden="true"></pre>

<script>
  const TAU = Math.PI * 2;
  // A 4×4 ordered-dither matrix: a dot is on when its light is over its threshold.
  const BAYER = [0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5].map((v) => (v + 0.5) / 16);
  // The bit of each dot in a braille cell, by column (0, 1) and row (0 to 3).
  const BIT = [
    [0x01, 0x02, 0x04, 0x40],
    [0x08, 0x10, 0x20, 0x80],
  ];
  const SHADES = 8;

  for (const pre of document.querySelectorAll<HTMLElement>('.torus')) {
    const cols = Number(pre.dataset.cols);
    const rows = Number(pre.dataset.rows);
    const W = cols * 2;
    const H = rows * 4;
    const z = new Float32Array(W * H);
    const lum = new Float32Array(W * H);

    // The shape of a dot's place, so the ring stays round whatever the font: two dots across a cell, four down a line.
    // Measured again once the webfont is in, since a fallback font has other proportions.
    let aspect = 1;
    const measure = () => {
      const probe = document.createElement('span');
      probe.textContent = '⣿'.repeat(10);
      pre.append(probe);
      const box = probe.getBoundingClientRect();
      probe.remove();
      const lineHeight = parseFloat(getComputedStyle(pre).lineHeight) || box.height;
      aspect = box.width / 10 / 2 / (lineHeight / 4) || 1;
    };
    measure();
    document.fonts?.ready.then(() => {
      measure();
      frame(A, B);
    });

    // The angles' sines and cosines, once.
    const ring = (step: number) => {
      const n = Math.ceil(TAU / step);
      const s = new Float32Array(n);
      const c = new Float32Array(n);
      for (let k = 0; k < n; k++) {
        s[k] = Math.sin(k * step);
        c[k] = Math.cos(k * step);
      }
      return { n, s, c };
    };
    const theta = ring(0.03);
    const phi = ring(0.011);

    const frame = (A: number, B: number) => {
      z.fill(0);
      lum.fill(-9);
      const sA = Math.sin(A), cA = Math.cos(A), sB = Math.sin(B), cB = Math.cos(B);
      const kx = W * 0.6;
      const ky = kx * aspect;
      for (let j = 0; j < theta.n; j++) {
        const ct = theta.c[j], st = theta.s[j];
        const h = ct + 2;
        for (let i = 0; i < phi.n; i++) {
          const sp = phi.s[i], cp = phi.c[i];
          const D = 1 / (sp * h * sA + st * cA + 5);
          const t = sp * h * cA - st * sA;
          const x = (W / 2 + kx * D * (cp * h * cB - t * sB)) | 0;
          const y = (H / 2 + ky * D * (cp * h * sB + t * cB)) | 0;
          if (y < 0 || y >= H || x < 0 || x >= W) continue;
          const o = x + W * y;
          if (D <= z[o]) continue;
          z[o] = D;
          lum[o] = (st * sA - sp * ct * cA) * cB - sp * ct * sA - st * cA - cp * ct * sB;
        }
      }
      let html = '';
      for (let cy = 0; cy < rows; cy++) {
        let run = '';
        let shade = -2;
        for (let cx = 0; cx < cols; cx++) {
          let bits = 0;
          let sum = 0;
          let lit = 0;
          for (let dx = 0; dx < 2; dx++) {
            for (let dy = 0; dy < 4; dy++) {
              const x = cx * 2 + dx;
              const y = cy * 4 + dy;
              const l = lum[x + W * y];
              if (l < -8) continue;
              // Full light goes solid; the shaded side keeps a sparse dusting of dots, so the whole ring reads.
              const v = Math.min(1, 0.07 + 1.25 * Math.max(0, l / 1.42));
              if (v > BAYER[(y & 3) * 4 + (x & 3)]) {
                bits |= BIT[dx][dy];
                sum += v;
                lit++;
              }
            }
          }
          const s = lit ? Math.min(SHADES - 1, Math.floor((sum / lit) * SHADES)) : -1;
          if (s !== shade) {
            if (run) html += shade < 0 ? run : `<span class="g${shade}">${run}</span>`;
            run = '';
            shade = s;
          }
          run += bits ? String.fromCharCode(0x2800 + bits) : ' ';
        }
        if (run) html += shade < 0 ? run : `<span class="g${shade}">${run}</span>`;
        html += '\n';
      }
      pre.innerHTML = html;
    };

    let A = 1.0;
    let B = 0.5;
    frame(A, B);

    const still = matchMedia('(prefers-reduced-motion: reduce)');
    let visible = true;
    let running = false;
    let last = 0;
    const step = (now: number) => {
      if (!visible || still.matches) {
        running = false;
        return;
      }
      if (now - last > 33) {
        A += 0.04;
        B += 0.018;
        frame(A, B);
        last = now;
      }
      requestAnimationFrame(step);
    };
    const start = () => {
      if (running || !visible || still.matches) return;
      running = true;
      requestAnimationFrame(step);
    };
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      start();
    }).observe(pre);
    still.addEventListener('change', start);
    start();
  }
</script>
