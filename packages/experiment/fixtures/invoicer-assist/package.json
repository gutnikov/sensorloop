{
  "name": "invoicer",
  "version": "0.5.0",
  "private": true,
  "description": "Reports on a file of invoices: what was billed, what is overdue, a CSV for spreadsheets, and each line's accounting category.",
  "type": "module",
  "bin": {
    "invoicer": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "eval": "tsx scripts/eval.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.137.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
