{
  "name": "invoicer-web",
  "version": "0.3.0",
  "private": true,
  "description": "The invoices, their customers and what is owed, in the browser.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lighthouse": "npm run build && lhci autorun"
  },
  "dependencies": {
    "express": "5.3.0",
    "helmet": "8.3.0"
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
